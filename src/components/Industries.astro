---
// Industries.astro - Mosaico Fotográfico en Efecto Espejo (Limpio, Sin Burbujas de Sector ni Etiquetas)
import { topIndustries, bottomIndustries } from '../data/industries';
---

<section id="sectores" class="py-24 bg-white border-t border-black/[0.06] relative overflow-hidden">
  <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <h2 class="font-bebas text-4xl sm:text-6xl text-[#030303] tracking-tight uppercase leading-none">
          TU SECTOR, <span class="border-b-4 border-[#26CCCA] inline-block">TU ECOSISTEMA</span>
        </h2>
      </div>
      <p class="font-poppins text-sm sm:text-base text-[#52525B] max-w-md leading-relaxed">
        Llevamos nuestra metodología digital a 6 industrias clave en Chile. Cada sector tiene sus propios desafíos y nosotros conocemos sus soluciones.
      </p>
    </div>

    <!-- Mosaico en Efecto Espejo -->
    <div class="space-y-5">
      <!-- Fila Superior: 1 Grande Izquierda + 2 Pequeños Derecha -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-5">
        <!-- 01 Construcción (Grande Izquierda - 7 columnas) -->
        <a 
          href={topIndustries[0].href} 
          target={topIndustries[0].href.startsWith('/') ? undefined : "_blank"}
          class="group relative rounded-3xl overflow-hidden lg:col-span-7 min-h-[440px] lg:min-h-[530px] flex flex-col justify-between p-6 sm:p-8 transition-all duration-500 border border-black/10 hover:border-[#26CCCA] hover:shadow-2xl shadow-sm"
        >
          <div class="absolute inset-0 z-0 overflow-hidden">
            <img 
              src={topIndustries[0].image} 
              alt={topIndustries[0].name}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-black/20 group-hover:via-black/55 transition-colors duration-300"></div>
          </div>

          <!-- Top Action Arrow (Limpio) -->
          <div class="relative z-10 flex justify-end">
            <div class="w-10 h-10 rounded-full bg-white/15 backdrop-blur-md border border-white/25 flex items-center justify-center text-white group-hover:bg-[#26CCCA] group-hover:text-[#030303] group-hover:border-[#26CCCA] transition-all duration-300 shadow-md">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>

          <!-- Bottom Text Content -->
          <div class="relative z-10 mt-auto pt-8">
            <h3 class="font-outfit text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-2 leading-tight tracking-tight drop-shadow-sm">
              {topIndustries[0].name}
            </h3>
            <p class="font-poppins text-xs sm:text-sm text-zinc-200/90 leading-relaxed max-w-xl">
              {topIndustries[0].description}
            </p>
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-[#26CCCA] scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
        </a>

        <!-- 2 Pequeños Derecha (5 columnas) -->
        <div class="lg:col-span-5 flex flex-col gap-5">
          <!-- 02 Belleza -->
          <a 
            href={topIndustries[1].href} 
            target={topIndustries[1].href.startsWith('/') ? undefined : "_blank"}
            class="group relative rounded-3xl overflow-hidden min-h-[250px] flex flex-col justify-between p-6 transition-all duration-500 border border-black/10 hover:border-[#26CCCA] hover:shadow-xl shadow-sm flex-1"
          >
            <div class="absolute inset-0 z-0 overflow-hidden">
              <img 
                src={topIndustries[1].image} 
                alt={topIndustries[1].name}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-black/20 group-hover:via-black/55 transition-colors duration-300"></div>
            </div>

            <!-- Top Action Arrow -->
            <div class="relative z-10 flex justify-end">
              <div class="w-9 h-9 rounded-full bg-white/15 backdrop-blur-md border border-white/25 flex items-center justify-center text-white group-hover:bg-[#26CCCA] group-hover:text-[#030303] transition-all">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>

            <!-- Bottom Text -->
            <div class="relative z-10 mt-auto pt-4">
              <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white mb-1 leading-tight">
                {topIndustries[1].name}
              </h3>
              <p class="font-poppins text-xs text-zinc-200/90 leading-relaxed line-clamp-2">
                {topIndustries[1].description}
              </p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-[#26CCCA] scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
          </a>

          <!-- 03 Hospitalidad -->
          <a 
            href={topIndustries[2].href} 
            target={topIndustries[2].href.startsWith('/') ? undefined : "_blank"}
            class="group relative rounded-3xl overflow-hidden min-h-[250px] flex flex-col justify-between p-6 transition-all duration-500 border border-black/10 hover:border-[#26CCCA] hover:shadow-xl shadow-sm flex-1"
          >
            <div class="absolute inset-0 z-0 overflow-hidden">
              <img 
                src={topIndustries[2].image} 
                alt={topIndustries[2].name}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-black/20 group-hover:via-black/55 transition-colors duration-300"></div>
            </div>

            <!-- Top Action Arrow -->
            <div class="relative z-10 flex justify-end">
              <div class="w-9 h-9 rounded-full bg-white/15 backdrop-blur-md border border-white/25 flex items-center justify-center text-white group-hover:bg-[#26CCCA] group-hover:text-[#030303] transition-all">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>

            <!-- Bottom Text -->
            <div class="relative z-10 mt-auto pt-4">
              <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white mb-1 leading-tight">
                {topIndustries[2].name}
              </h3>
              <p class="font-poppins text-xs text-zinc-200/90 leading-relaxed line-clamp-2">
                {topIndustries[2].description}
              </p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-[#26CCCA] scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
          </a>
        </div>
      </div>

      <!-- Fila Inferior (EFECTO ESPEJO): 2 Pequeños Izquierda + 1 Grande Derecha -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-5">
        <!-- 2 Pequeños Izquierda (5 columnas) -->
        <div class="lg:col-span-5 flex flex-col gap-5 order-2 lg:order-1">
          <!-- 04 Servicios Profesionales -->
          <a 
            href={bottomIndustries[0].href} 
            target={bottomIndustries[0].href.startsWith('/') ? undefined : "_blank"}
            class="group relative rounded-3xl overflow-hidden min-h-[250px] flex flex-col justify-between p-6 transition-all duration-500 border border-black/10 hover:border-[#26CCCA] hover:shadow-xl shadow-sm flex-1"
          >
            <div class="absolute inset-0 z-0 overflow-hidden">
              <img 
                src={bottomIndustries[0].image} 
                alt={bottomIndustries[0].name}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-black/20 group-hover:via-black/55 transition-colors duration-300"></div>
            </div>

            <!-- Top Action Arrow -->
            <div class="relative z-10 flex justify-end">
              <div class="w-9 h-9 rounded-full bg-white/15 backdrop-blur-md border border-white/25 flex items-center justify-center text-white group-hover:bg-[#26CCCA] group-hover:text-[#030303] transition-all">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>

            <!-- Bottom Text -->
            <div class="relative z-10 mt-auto pt-4">
              <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white mb-1 leading-tight">
                {bottomIndustries[0].name}
              </h3>
              <p class="font-poppins text-xs text-zinc-200/90 leading-relaxed line-clamp-2">
                {bottomIndustries[0].description}
              </p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-[#26CCCA] scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
          </a>

          <!-- 05 Educación -->
          <a 
            href={bottomIndustries[1].href} 
            target={bottomIndustries[1].href.startsWith('/') ? undefined : "_blank"}
            class="group relative rounded-3xl overflow-hidden min-h-[250px] flex flex-col justify-between p-6 transition-all duration-500 border border-black/10 hover:border-[#26CCCA] hover:shadow-xl shadow-sm flex-1"
          >
            <div class="absolute inset-0 z-0 overflow-hidden">
              <img 
                src={bottomIndustries[1].image} 
                alt={bottomIndustries[1].name}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-black/20 group-hover:via-black/55 transition-colors duration-300"></div>
            </div>

            <!-- Top Action Arrow -->
            <div class="relative z-10 flex justify-end">
              <div class="w-9 h-9 rounded-full bg-white/15 backdrop-blur-md border border-white/25 flex items-center justify-center text-white group-hover:bg-[#26CCCA] group-hover:text-[#030303] transition-all">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>

            <!-- Bottom Text -->
            <div class="relative z-10 mt-auto pt-4">
              <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white mb-1 leading-tight">
                {bottomIndustries[1].name}
              </h3>
              <p class="font-poppins text-xs text-zinc-200/90 leading-relaxed line-clamp-2">
                {bottomIndustries[1].description}
              </p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-[#26CCCA] scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
          </a>
        </div>

        <!-- 06 Retail (Grande Derecha - 7 columnas) -->
        <a 
          href={bottomIndustries[2].href} 
          target={bottomIndustries[2].href.startsWith('/') ? undefined : "_blank"}
          class="group relative rounded-3xl overflow-hidden lg:col-span-7 min-h-[440px] lg:min-h-[530px] flex flex-col justify-between p-6 sm:p-8 transition-all duration-500 border border-black/10 hover:border-[#26CCCA] hover:shadow-2xl shadow-sm order-1 lg:order-2"
        >
          <div class="absolute inset-0 z-0 overflow-hidden">
            <img 
              src={bottomIndustries[2].image} 
              alt={bottomIndustries[2].name}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-black/20 group-hover:via-black/55 transition-colors duration-300"></div>
          </div>

          <!-- Top Action Arrow -->
          <div class="relative z-10 flex justify-end">
            <div class="w-10 h-10 rounded-full bg-white/15 backdrop-blur-md border border-white/25 flex items-center justify-center text-white group-hover:bg-[#26CCCA] group-hover:text-[#030303] group-hover:border-[#26CCCA] transition-all duration-300 shadow-md">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>

          <!-- Bottom Text -->
          <div class="relative z-10 mt-auto pt-8">
            <h3 class="font-outfit text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-2 leading-tight tracking-tight drop-shadow-sm">
              {bottomIndustries[2].name}
            </h3>
            <p class="font-poppins text-xs sm:text-sm text-zinc-200/90 leading-relaxed max-w-xl">
              {bottomIndustries[2].description}
            </p>
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-[#26CCCA] scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
        </a>
      </div>
    </div>
  </div>
</section>
