---
// FullScreenHeroFX.astro - Hero Cinemático Editorial con Tamaños Originales Grandes, Scroll Libre y Acentos #26CCCA
const slides = [
  {
    id: "marketing",
    number: "01",
    leftLabel: "MARKETING",
    title: "VENTAS",
    rightLabel: "MARKETING",
    category: "Pilar 01 — Contenido & Adquisición",
    subtitle: "Identidades visuales de alto impacto y contenidos estratégicos que atraen, educan y convierten prospectos en clientes leales.",
    bg: "/mockup/hero_pilar_marketing.jpg"
  },
  {
    id: "charlie-ia",
    number: "02",
    leftLabel: "CHARLIE IA",
    title: "AUTONOMÍA",
    rightLabel: "CHARLIE IA",
    category: "Pilar 02 — Agentes Inteligentes 24/7",
    subtitle: "El único colaborador que trabaja 24/7: clasifica intención de compra por WhatsApp, responde consultas complejas y sincroniza tu CRM en tiempo real.",
    bg: "/mockup/hero_architecture_noir.jpg",
    overlayImg: "/images/Charlie/Charlie-2.png"
  },
  {
    id: "software",
    number: "03",
    leftLabel: "SOFTWARE",
    title: "VELOCIDAD",
    rightLabel: "SOFTWARE",
    category: "Pilar 03 — Plataformas & Web Boutique",
    subtitle: "Ingeniería de vanguardia: experiencias digitales boutique, velocidad de carga sub-segundo (Lighthouse 99+) y máxima conversión.",
    bg: "/mockup/hero_pilar_software.jpg"
  },
  {
    id: "escala",
    number: "04",
    leftLabel: "ESCALA",
    title: "RESULTADOS",
    rightLabel: "ESCALA",
    category: "Pilar 04 — Automatización de Procesos",
    subtitle: "Flujos automatizados que eliminan tareas operativas repetitivas con retorno de inversión medible en menos de 60 días.",
    bg: "/mockup/hero_pilar_escala.jpg"
  }
];
---

<section id="hero-fx" class="relative w-full h-screen h-[100svh] min-h-[660px] bg-[#030303] text-white overflow-hidden select-none">
  
  <!-- Dynamic Cinematic Backgrounds with Crossfade -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    {slides.map((s, i) => (
      <div 
        id={`fx-bg-${i}`} 
        class={`absolute inset-0 transition-all duration-1000 ease-out ${i === 0 ? 'opacity-100 scale-100' : 'opacity-0 scale-105'}`}
      >
        <img 
          src={s.bg} 
          alt={s.title}
          class="w-full h-full object-cover brightness-[0.34] contrast-120 saturate-[0.85]"
          loading={i === 0 ? "eager" : "lazy"}
        />
        {s.overlayImg && (
          <img 
            src={s.overlayImg} 
            alt="Charlie IA" 
            class="absolute bottom-0 right-[4%] lg:right-[8%] h-[68%] lg:h-[78%] object-contain brightness-[0.40] contrast-125 opacity-75 drop-shadow-[0_0_60px_rgba(38,204,202,0.35)] pointer-events-none hidden sm:block" 
          />
        )}
        <!-- Vignettes & Depth Gradients -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#030303] via-black/35 to-[#030303]/85"></div>
        <div class="absolute inset-0 bg-radial from-transparent via-black/30 to-[#030303]/90"></div>
      </div>
    ))}
  </div>

  <!-- Ambient Teal Accent Glow (Adds Depth in #26CCCA) -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[480px] bg-[#26CCCA]/12 rounded-full blur-[170px] pointer-events-none z-1"></div>

  <!-- Top Header: THE CREATIVE PROCESS (Con CREATIVE en #26CCCA) -->
  <div class="fx-header absolute top-24 sm:top-28 left-0 right-0 z-20 text-center pointer-events-none px-4">
    <h2 class="font-outfit font-extrabold text-3xl sm:text-5xl lg:text-6xl text-white tracking-tight uppercase leading-[0.9] drop-shadow-xl">
      <span class="block">THE <span class="text-[#26CCCA]">CREATIVE</span></span>
      <span class="block text-white">PROCESS</span>
    </h2>
  </div>

  <!-- Lateral Left Column (Posición y Tamaños Originales Grandes) -->
  <div class="fx-lateral-left absolute left-6 sm:left-12 lg:left-16 top-1/2 -translate-y-1/2 z-20 flex flex-col gap-4 sm:gap-5 select-none">
    {slides.map((s, i) => (
      <button
        type="button"
        class={`fx-left-btn group flex items-center gap-3 text-left transition-all duration-300 cursor-pointer focus:outline-none ${i === 0 ? 'active' : ''}`}
        data-index={i}
        aria-label={`Seleccionar sección ${s.leftLabel}`}
      >
        <!-- Bullet Dot (Cyan #26CCCA Glow Circle Before the Word) -->
        <span 
          id={`fx-left-bullet-${i}`}
          class={`w-2.5 h-2.5 rounded-full shrink-0 transition-all duration-300 ${
            i === 0 
              ? 'bg-[#26CCCA] shadow-[0_0_12px_#26CCCA] opacity-100 scale-100' 
              : 'bg-white/40 opacity-0 scale-0'
          }`}
        ></span>
        <!-- Lateral Text (Tamaño Original) -->
        <span 
          id={`fx-left-label-${i}`}
          class={`font-outfit text-base sm:text-lg lg:text-xl font-black uppercase tracking-tight transition-all duration-300 group-hover:text-white ${
            i === 0 ? 'text-white opacity-100 translate-x-1.5' : 'text-zinc-400 opacity-35'
          }`}
        >
          {s.leftLabel}
        </span>
      </button>
    ))}
  </div>

  <!-- Center Stage: Massive Feature Title & Context (Tamaño Original Monumental) -->
  <div class="fx-center-stage absolute inset-0 z-10 flex flex-col items-center justify-center pointer-events-none px-4 pt-16 sm:pt-20">
    
    <!-- Category Badge in #26CCCA -->
    <div class="mb-3">
      <span id="fx-category" class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#26CCCA] transition-opacity duration-300">
        {slides[0].category}
      </span>
    </div>

    <!-- Feature Title Container (Tamaño Original) -->
    <div class="relative w-full max-w-4xl h-32 sm:h-44 lg:h-52 flex items-center justify-center">
      {slides.map((s, i) => (
        <div 
          id={`fx-center-${i}`}
          class={`absolute inset-0 flex items-center justify-center transition-all duration-600 ease-out ${
            i === 0 ? 'opacity-100 translate-y-0 scale-100' : 'opacity-0 translate-y-8 scale-95 pointer-events-none'
          }`}
        >
          <h1 class="font-outfit font-black text-6xl sm:text-8xl lg:text-9xl text-white uppercase tracking-tighter drop-shadow-2xl">
            {s.title}
          </h1>
        </div>
      ))}
    </div>

    <!-- Dynamic Subtitle -->
    <p id="fx-subtitle" class="font-poppins text-xs sm:text-sm lg:text-base text-zinc-300 max-w-lg mx-auto leading-relaxed mt-2 mb-7 transition-opacity duration-300 text-center">
      {slides[0].subtitle}
    </p>

    <!-- Conversion Buttons -->
    <div class="pointer-events-auto flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
      <a 
        href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ0eLzWvh-yrlAvDqP4vCBpex5c2wtzqpp89n_C4VVp6Obx184OHVTcQxAJBAtq4CtJtcYmyMuuA" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn-primary w-full sm:w-auto text-xs uppercase tracking-wider py-3.5 px-7 flex items-center justify-center gap-2 border border-[#26CCCA]/40 shadow-[0_0_20px_rgba(38,204,202,0.15)] hover:shadow-[0_0_25px_rgba(38,204,202,0.35)]"
      >
        <span>Agenda un diagnóstico gratuito</span>
        <svg class="w-3.5 h-3.5 shrink-0 transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a 
        href="#charlie"
        class="w-full sm:w-auto text-xs uppercase tracking-wider py-3.5 px-6 rounded-full bg-white/10 hover:bg-[#26CCCA] text-white hover:text-[#030303] font-outfit font-bold border border-white/20 hover:border-[#26CCCA] transition-all text-center flex items-center justify-center gap-2 shadow-lg cursor-pointer backdrop-blur-sm"
      >
        <span>Conoce a Charlie™</span>
      </a>
    </div>

  </div>

  <!-- Lateral Right Column (Posición y Tamaños Originales Grandes) -->
  <div class="fx-lateral-right absolute right-6 sm:right-12 lg:right-16 top-1/2 -translate-y-1/2 z-20 flex flex-col gap-4 sm:gap-5 select-none items-end">
    {slides.map((s, i) => (
      <button
        type="button"
        class={`fx-right-btn group flex items-center justify-end gap-3 text-right transition-all duration-300 cursor-pointer focus:outline-none ${i === 0 ? 'active' : ''}`}
        data-index={i}
        aria-label={`Seleccionar sección ${s.rightLabel}`}
      >
        <!-- Lateral Text (Tamaño Original) -->
        <span 
          id={`fx-right-label-${i}`}
          class={`font-outfit text-base sm:text-lg lg:text-xl font-black uppercase tracking-tight transition-all duration-300 group-hover:text-white ${
            i === 0 ? 'text-white opacity-100 -translate-x-1.5' : 'text-zinc-400 opacity-35'
          }`}
        >
          {s.rightLabel}
        </span>
        <!-- Bullet Dot (Cyan #26CCCA Glow Circle After the Word) -->
        <span 
          id={`fx-right-bullet-${i}`}
          class={`w-2.5 h-2.5 rounded-full shrink-0 transition-all duration-300 ${
            i === 0 
              ? 'bg-[#26CCCA] shadow-[0_0_12px_#26CCCA] opacity-100 scale-100' 
              : 'bg-white/40 opacity-0 scale-0'
          }`}
        ></span>
      </button>
    ))}
  </div>



</section>

<script define:vars={{ slides }}>
  const total = slides.length;
  let currentIndex = 0;
  let autoplayTimer = null;
  const AUTOPLAY_INTERVAL = 5000;

  const categoryEl = document.getElementById('fx-category');
  const subtitleEl = document.getElementById('fx-subtitle');

  function updateVisuals(newIndex) {
    if (newIndex < 0) newIndex = total - 1;
    if (newIndex >= total) newIndex = 0;
    currentIndex = newIndex;
    const slide = slides[currentIndex];

    // 1. Backgrounds Crossfade
    for (let i = 0; i < total; i++) {
      const bg = document.getElementById(`fx-bg-${i}`);
      if (bg) {
        if (i === currentIndex) {
          bg.classList.remove('opacity-0', 'scale-105');
          bg.classList.add('opacity-100', 'scale-100');
        } else {
          bg.classList.remove('opacity-100', 'scale-100');
          bg.classList.add('opacity-0', 'scale-105');
        }
      }
    }

    // 2. Left Lateral List (Restaurando Clases Originales Grandes)
    for (let i = 0; i < total; i++) {
      const bullet = document.getElementById(`fx-left-bullet-${i}`);
      const label = document.getElementById(`fx-left-label-${i}`);
      const btn = document.querySelector(`.fx-left-btn[data-index="${i}"]`);

      if (i === currentIndex) {
        if (bullet) {
          bullet.className = "w-2.5 h-2.5 rounded-full shrink-0 transition-all duration-300 bg-[#26CCCA] shadow-[0_0_12px_#26CCCA] opacity-100 scale-100";
        }
        if (label) {
          label.className = "font-outfit text-base sm:text-lg lg:text-xl font-black uppercase tracking-tight transition-all duration-300 text-white opacity-100 translate-x-1.5";
        }
        if (btn) btn.classList.add('active');
      } else {
        if (bullet) {
          bullet.className = "w-2.5 h-2.5 rounded-full shrink-0 transition-all duration-300 bg-white/40 opacity-0 scale-0";
        }
        if (label) {
          label.className = "font-outfit text-base sm:text-lg lg:text-xl font-black uppercase tracking-tight transition-all duration-300 text-zinc-400 opacity-35";
        }
        if (btn) btn.classList.remove('active');
      }
    }

    // 3. Right Lateral List (Restaurando Clases Originales Grandes)
    for (let i = 0; i < total; i++) {
      const bullet = document.getElementById(`fx-right-bullet-${i}`);
      const label = document.getElementById(`fx-right-label-${i}`);
      const btn = document.querySelector(`.fx-right-btn[data-index="${i}"]`);

      if (i === currentIndex) {
        if (bullet) {
          bullet.className = "w-2.5 h-2.5 rounded-full shrink-0 transition-all duration-300 bg-[#26CCCA] shadow-[0_0_12px_#26CCCA] opacity-100 scale-100";
        }
        if (label) {
          label.className = "font-outfit text-base sm:text-lg lg:text-xl font-black uppercase tracking-tight transition-all duration-300 text-white opacity-100 -translate-x-1.5";
        }
        if (btn) btn.classList.add('active');
      } else {
        if (bullet) {
          bullet.className = "w-2.5 h-2.5 rounded-full shrink-0 transition-all duration-300 bg-white/40 opacity-0 scale-0";
        }
        if (label) {
          label.className = "font-outfit text-base sm:text-lg lg:text-xl font-black uppercase tracking-tight transition-all duration-300 text-zinc-400 opacity-35";
        }
        if (btn) btn.classList.remove('active');
      }
    }

    // 4. Center Featured Title (Tamaño Original)
    for (let i = 0; i < total; i++) {
      const center = document.getElementById(`fx-center-${i}`);
      if (center) {
        if (i === currentIndex) {
          center.classList.remove('opacity-0', 'translate-y-8', 'scale-95', 'pointer-events-none');
          center.classList.add('opacity-100', 'translate-y-0', 'scale-100');
        } else {
          center.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
          center.classList.add('opacity-0', 'translate-y-8', 'scale-95', 'pointer-events-none');
        }
      }
    }

    // 5. Category & Subtitle Text Update with Smooth Fade
    if (categoryEl) {
      categoryEl.style.opacity = '0';
      setTimeout(() => {
        categoryEl.textContent = slide.category;
        categoryEl.style.opacity = '1';
      }, 150);
    }

    if (subtitleEl) {
      subtitleEl.style.opacity = '0';
      setTimeout(() => {
        subtitleEl.textContent = slide.subtitle;
        subtitleEl.style.opacity = '1';
      }, 150);
    }

    // Reset Autoplay on every switch
    resetAutoplay();
  }

  function startAutoplay() {
    autoplayTimer = setInterval(() => {
      updateVisuals(currentIndex + 1);
    }, AUTOPLAY_INTERVAL);
  }

  function resetAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
    startAutoplay();
  }

  // Bind Lateral Clicks
  document.querySelectorAll('.fx-left-btn, .fx-right-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
      updateVisuals(idx);
    });
  });

  // Keyboard navigation when hero is in view
  window.addEventListener('keydown', (e) => {
    const heroEl = document.getElementById('hero-fx');
    if (!heroEl) return;
    const rect = heroEl.getBoundingClientRect();
    if (rect.top > 100 || rect.bottom < 100) return;

    if (e.key === 'ArrowRight') updateVisuals(currentIndex + 1);
    if (e.key === 'ArrowLeft') updateVisuals(currentIndex - 1);
  });

  // Initialize Autoplay on page load
  startAutoplay();
</script>
