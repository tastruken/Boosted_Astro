---
// src/components/CircularSplitRoll.astro - Reel Vertical con Curvatura Sutil (Fiel a la Referencia)
export interface SubsectorItem {
  number: string;
  title: string;
  description: string;
  icon: string;
  tag: string;
  image: string;
}

interface Props {
  items: SubsectorItem[];
  sectionHeight?: number;
  kicker?: string;
  subtitle?: string;
  footerNote?: string;
  badgeText?: string;
}

const {
  items,
  sectionHeight = 70,
  kicker = "SUBSECTORES · ESPECIALIZACIÓN OPERATIVA",
  subtitle = "Ecosistemas adaptados a las dinámicas operativas específicas de cada rubro en la industria de la belleza, la estética y el bienestar personal:",
  footerNote = "Ecosistemas digitales sincronizados para estudios de estética y belleza",
  badgeText = `${items.length} Especialidades Adaptadas`,
} = Astro.props;
---

<section 
  id="subsectores" 
  class="relative w-full bg-[#F9F9FA] border-t border-black/5 overflow-clip scroll-mt-20"
  data-total-items={items.length}
  data-section-height={sectionHeight}
>
  <!-- 1. VISTA ESCRITORIO (>= 1024px): Reel Vertical Elegante (Solo el Costado Visible) -->
  <div 
    id="circular-sticky-wrapper" 
    class="relative h-screen w-full overflow-hidden hidden lg:flex flex-col justify-between pt-24 pb-6 px-8 sm:px-16 max-w-[1536px] mx-auto select-none"
  >
    <!-- Header Superior Limpio y Discreto -->
    <div class="relative z-30 flex items-end justify-between border-b border-black/5 pb-4">
      <div>
        <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88] block mb-1">
          {kicker}
        </span>
        <h2 class="font-bebas text-3xl sm:text-4xl text-[#030303] tracking-tight uppercase leading-none">
          APLICACIONES POR <span class="border-b-2 border-[#26CCCA] inline-block">TIPO DE NEGOCIO</span>
        </h2>
      </div>

      <!-- Contador y Micro Barra de Progreso -->
      <div class="flex items-center gap-5">
        <div class="text-right">
          <span class="font-outfit text-[11px] font-semibold uppercase text-zinc-400 block tracking-wider">
            Sector
          </span>
          <span id="roll-counter" class="font-bebas text-3xl text-[#030303] leading-none tracking-wider">
            01 / 0{items.length}
          </span>
        </div>
        <div class="w-28 h-1.5 bg-black/10 rounded-full overflow-hidden">
          <div id="roll-progress-bar" class="h-full bg-[#26CCCA] rounded-full transition-all duration-150 w-[11%]"></div>
        </div>
        <div class="hidden xl:flex items-center gap-1.5 text-xs font-outfit uppercase font-semibold text-zinc-400 tracking-wider">
          <span>Desliza para explorar</span>
          <span class="text-[#26CCCA] animate-bounce">↓</span>
        </div>
      </div>
    </div>

    <!-- Escenario Central (2 Columnas Espaciosas: Izquierda Descripciones / Derecha Imagen Grande) -->
    <div class="relative flex-1 w-full grid grid-cols-12 gap-8 xl:gap-16 items-center my-auto overflow-hidden [mask-image:linear-gradient(to_bottom,transparent_0%,black_16%,black_84%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,transparent_0%,black_16%,black_84%,transparent_100%)]">
      
      <!-- Columna Izquierda (6 columnas): Títulos y Descripciones con Aire -->
      <div class="col-span-6 relative h-[72vh] flex items-center justify-end pr-4 xl:pr-10 pointer-events-none">
        <div class="relative w-full max-w-lg xl:max-w-xl h-full flex items-center justify-center">
          {items.map((item, index) => (
            <div 
              data-index={index}
              class="circular-scroll-showcase__left-item pointer-events-none absolute left-0 right-0 top-1/2 -translate-y-1/2 origin-left opacity-0 will-change-[transform,opacity]"
            >
              <!-- Eyebrow: Número + Tag -->
              <div class="flex items-center gap-3 mb-3">
                <span class="font-bebas text-2xl sm:text-3xl text-[#26CCCA] tracking-wider leading-none">
                  {item.number}
                </span>
                <span class="w-4 h-px bg-zinc-300"></span>
                <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88]">
                  {item.tag}
                </span>
              </div>

              <!-- Título en Grande y Espacioso -->
              <h3 class="font-outfit text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-[#030303] leading-[1.08] tracking-tight mb-4">
                {item.title}
              </h3>

              <!-- Descripción Operativa Completa -->
              <p class="font-poppins text-sm sm:text-base lg:text-lg text-[#52525B] leading-relaxed max-w-md xl:max-w-lg">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Columna Derecha (6 columnas): Tarjeta con IMAGEN HORIZONTAL Panorámica -->
      <div class="col-span-6 relative h-[72vh] flex items-center justify-start pl-4 xl:pl-10">
        <div class="relative w-[440px] h-[270px] lg:w-[490px] lg:h-[300px] xl:w-[540px] xl:h-[330px] flex items-center justify-center">
          {items.map((item, index) => (
            <div 
              data-index={index}
              class="circular-scroll-showcase__right-item absolute left-0 top-0 w-full h-full origin-center opacity-0 will-change-[transform,opacity]"
            >
              <!-- Cuadro de Imagen Horizontal (Cinematográfico, Redondeado, Sin Sobreponerse) -->
              <div class="relative h-full w-full rounded-[24px] xl:rounded-[30px] overflow-hidden bg-white shadow-[0_25px_60px_rgba(0,0,0,0.16),0_8px_20px_rgba(0,0,0,0.06)] border border-black/5">
                <img 
                  src={item.image} 
                  alt={item.title} 
                  class="w-full h-full object-cover select-none pointer-events-none" 
                  draggable="false" 
                />
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Footer Inferior Discreto -->
    <div class="relative z-30 flex items-center justify-between text-xs font-outfit text-zinc-400 border-t border-black/5 pt-3">
      <span>{footerNote}</span>
      <span class="text-[#0E8A88] font-semibold">{badgeText}</span>
    </div>
  </div>

  <!-- 2. VISTA MÓVIL Y TABLET (< 1024px): Grilla Limpia y Adaptada -->
  <div class="w-full px-4 sm:px-8 py-16 lg:hidden">
    <div class="max-w-3xl mb-12">
      <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-2">
        SUBSECTORES
      </span>
      <h2 class="font-bebas text-4xl sm:text-5xl text-[#030303] tracking-tight uppercase leading-none mb-4">
        APLICACIONES POR <span class="border-b-4 border-[#26CCCA] inline-block">TIPO DE NEGOCIO</span>
      </h2>
      <p class="font-poppins text-sm sm:text-base text-[#52525B] leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Tarjetas Mobile con Imagen y Descripción -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {items.map((item) => (
        <article class="rounded-3xl bg-white border border-zinc-200/90 shadow-sm overflow-hidden flex flex-col justify-between">
          <!-- Imagen Superior -->
          <div class="relative h-44 w-full overflow-hidden bg-zinc-100">
            <img 
              src={item.image} 
              alt={item.title} 
              class="w-full h-full object-cover" 
            />
          </div>

          <!-- Contenido Inferior -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <span class="font-outfit text-[11px] font-bold uppercase tracking-widest text-[#0E8A88] block mb-1">
                {item.tag}
              </span>
              <h3 class="font-outfit text-xl font-bold text-[#030303] mb-2 leading-tight">
                {item.title}
              </h3>
              <p class="font-poppins text-xs sm:text-sm text-[#52525B] leading-relaxed mb-4">
                {item.description}
              </p>
            </div>

            <div class="pt-3 border-t border-black/5 flex items-center justify-between text-xs font-outfit uppercase font-semibold text-zinc-500">
              <span>Especialidad</span>
              <span class="text-[#26CCCA] text-lg font-bold">→</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Script de Animación: Curvatura Sutil en el Costado (Sin Círculo Completo) -->
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initCircularSplitRoll() {
    const root = document.getElementById("subsectores");
    const sticky = document.getElementById("circular-sticky-wrapper");
    if (!root || !sticky) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) return;

    const mm = gsap.matchMedia();

    mm.add("(min-width: 1024px)", () => {
      const leftNodes = Array.from(root.querySelectorAll(".circular-scroll-showcase__left-item")) as HTMLElement[];
      const rightNodes = Array.from(root.querySelectorAll(".circular-scroll-showcase__right-item")) as HTMLElement[];
      const counterEl = document.getElementById("roll-counter");
      const progressBar = document.getElementById("roll-progress-bar");

      const total = leftNodes.length;
      if (!total) return;

      const DESKTOP_WIDTH = 1200;
      const TABLET_MIN_WIDTH = 768;

      // Parámetros de arco vertical: espacioso, horizontal y sin sobreposiciones
      const radiusYBase = 660; // Mayor separación vertical para que las imágenes nunca se toquen
      const bowXBase = 40;     // Curvatura horizontal sutil y limpia

      const textCenterScale = 1;
      const textSideScale = 0.80;

      const imageCenterScale = 1;
      const imageSideScale = 0.74;

      // Umbral estricto para máxima limpieza: el elemento activo brilla con 100% claridad
      const focusThreshold = 0.76;
      const focusPower = 2.8;

      function wrapProgress(value: number) {
        let wrapped = value % 1;
        if (wrapped < 0) {
          wrapped += 1;
        }
        return wrapped;
      }

      function shapeFocus(strength: number, start = focusThreshold, power = focusPower) {
        if (strength <= start) return 0;
        const normalized = gsap.utils.clamp(0, 1, (strength - start) / (1 - start));
        return Math.pow(normalized, power);
      }

      gsap.set([...leftNodes, ...rightNodes], { opacity: 0 });

      const render = (scrollProgress: number) => {
        const width = window.innerWidth || DESKTOP_WIDTH;
        let factor = 1;
        if (width < DESKTOP_WIDTH && width >= TABLET_MIN_WIDTH) {
          factor = width / DESKTOP_WIDTH;
        }

        const radiusY = radiusYBase * factor;
        const bowX = bowXBase * factor;

        // Actualizar contador y barra de progreso
        const activeIdx = Math.min(total - 1, Math.max(0, Math.round(scrollProgress * (total - 1))));
        if (counterEl) {
          counterEl.textContent = `${String(activeIdx + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
        }
        if (progressBar) {
          progressBar.style.width = `${((activeIdx + 1) / total) * 100}%`;
        }

        // 1. Items Izquierda: Títulos y Descripciones (Curvatura vertical sutil en el borde)
        leftNodes.forEach((node, index) => {
          const localProgress = wrapProgress(index / total - scrollProgress);
          // Ángulo relativo: 0 está en el centro
          const angle = localProgress * Math.PI * 2 + Math.PI * 0.5;

          const horizontalDepth = Math.sin(angle); // 1 en el foco central
          const rawStrength = gsap.utils.clamp(0, 1, (horizontalDepth + 1) / 2);
          const focusStrength = shapeFocus(rawStrength);

          if (focusStrength <= 0.001) {
            gsap.set(node, { opacity: 0, zIndex: 0 });
            return;
          }

          const y = Math.cos(angle) * radiusY;
          // Curvatura leve hacia la derecha al acercarse al centro
          const x = (horizontalDepth - 1) * -bowX;

          const scale = gsap.utils.interpolate(textSideScale, textCenterScale, focusStrength);
          const opacity = gsap.utils.interpolate(0, 1, focusStrength);
          const zIndex = Math.round(focusStrength * 30);

          gsap.set(node, {
            x,
            y,
            scale,
            opacity,
            zIndex,
            transformOrigin: "left center",
          });
        });

        // 2. Items Derecha: Cuadros de Imagen (Curvatura vertical simétrica en el borde)
        rightNodes.forEach((node, index) => {
          const localProgress = wrapProgress(index / total - scrollProgress);
          // Ángulo relativo opuesto
          const angle = localProgress * Math.PI * 2 - Math.PI * 0.5;

          const horizontalDepth = -Math.sin(angle); // 1 en el foco central
          const rawStrength = gsap.utils.clamp(0, 1, (horizontalDepth + 1) / 2);
          const focusStrength = shapeFocus(rawStrength);

          if (focusStrength <= 0.001) {
            gsap.set(node, { opacity: 0, zIndex: 0 });
            return;
          }

          const y = Math.cos(angle) * radiusY;
          // Curvatura leve hacia la izquierda al acercarse al centro
          const x = (horizontalDepth - 1) * bowX;

          const scale = gsap.utils.interpolate(imageSideScale, imageCenterScale, focusStrength);
          const opacity = gsap.utils.interpolate(0, 1, focusStrength);
          const zIndex = Math.round(focusStrength * 40);

          gsap.set(node, {
            x,
            y,
            scale,
            opacity,
            zIndex,
            transformOrigin: "center center",
          });
        });
      };

      render(0);

      const sectionHeightPercent = Number(root.dataset.sectionHeight) || 70;
      const scrollTrigger = ScrollTrigger.create({
        trigger: root,
        start: "top top",
        end: `+=${sectionHeightPercent * total}%`,
        pin: sticky,
        scrub: 1.1,
        pinSpacing: true,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          render(self.progress);
        },
      });

      const onResize = () => {
        render(scrollTrigger.progress);
        scrollTrigger.refresh();
      };

      window.addEventListener("resize", onResize);

      return () => {
        window.removeEventListener("resize", onResize);
        scrollTrigger.kill();
      };
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCircularSplitRoll);
  } else {
    initCircularSplitRoll();
  }
  document.addEventListener("astro:page-load", initCircularSplitRoll);
</script>
