<style>
  /* Bridge to prevent dropdown from closing during hover transition */
  .dropdown-container::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 12px;
  }
</style>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");
  const links = document.querySelectorAll(".mobile-nav-link");
  const accordionToggles = document.querySelectorAll(
    ".mobile-accordion-toggle",
  );

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener("click", () => {
      const isHidden = menu.classList.toggle("hidden");
      openIcon.classList.toggle("hidden", !isHidden);
      closeIcon.classList.toggle("hidden", isHidden);
    });

    links.forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        openIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      });
    });
  }

  // Mobile Accordion Logic
  accordionToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const targetId = toggle.getAttribute("data-target");
      if (!targetId) return;
      const target = document.getElementById(targetId);
      const icon = toggle.querySelector("svg");

      if (target) {
        const isClosed = target.classList.toggle("hidden");
        if (icon) {
          icon.style.transform = isClosed ? "rotate(0deg)" : "rotate(180deg)";
        }
      }
    });
  });

  // Header transparency logic on home page
  const header = document.getElementById("main-header");
  const isHomeHeader = header?.getAttribute("data-is-home") === "true";

  if (header && isHomeHeader) {
    const updateHeaderStyle = () => {
      if (window.scrollY > 40) {
        header.classList.remove("bg-transparent", "border-transparent");
        header.classList.add(
          "bg-[#030303]/90",
          "backdrop-blur-md",
          "border-white/[0.08]",
          "shadow-lg",
        );
      } else {
        header.classList.remove(
          "bg-[#030303]/90",
          "backdrop-blur-md",
          "border-white/[0.08]",
          "shadow-lg",
        );
        header.classList.add("bg-transparent", "border-transparent");
      }
    };

    window.addEventListener("scroll", updateHeaderStyle, { passive: true });
    updateHeaderStyle();
  }
</script>
