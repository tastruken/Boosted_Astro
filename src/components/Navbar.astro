---
// Navbar.astro - Barra de navegación oficial de Boosted con menús desplegables exactos
const pathname = new URL(Astro.request.url).pathname;
const isHome =
  pathname === "/" || pathname === "" || pathname === "/index.html";
const isNosotros = pathname.startsWith("/nosotros");
---

<header
  id="main-header"
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${
    isHome
      ? "bg-transparent border-b border-transparent"
      : "bg-[#030303]/90 backdrop-blur-md border-b border-white/[0.08]"
  }`}
  data-is-home={isHome ? "true" : "false"}
>
  <div
    class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12 h-20 flex items-center justify-between"
  >
    <!-- Logo Oficial -->
    <a
      href="/"
      class="group flex items-center focus:outline-none"
      aria-label="Boosted Inicio"
    >
      <img
        src="/images/logo/logo-white.png"
        alt="BOOSTED"
        class="h-7 sm:h-8 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden lg:flex items-center gap-6 xl:gap-8 font-poppins text-sm font-medium text-zinc-300"
      aria-label="Navegación principal"
    >
      <!-- Inicio -->
      <a
        href="/"
        class={`${isHome ? "text-[#26CCCA]" : "text-zinc-300"} hover:text-white transition-colors duration-150 py-2`}
      >
        Inicio
      </a>

      <!-- Nosotros -->
      <a
        href="/nosotros"
        class={`${isNosotros ? "text-[#26CCCA]" : "text-zinc-300"} hover:text-white transition-colors duration-150 py-2`}
      >
        Nosotros
      </a>

      <!-- Charlie -->
      <a
        href="https://boosted.cl/charlie.html"
        class="text-zinc-300 hover:text-white transition-colors duration-150 py-2"
      >
        Charlie
      </a>

      <!-- Dropdown: Servicios -->
      <div class="relative group dropdown-container">
        <button
          type="button"
          class="flex items-center gap-1.5 text-zinc-300 group-hover:text-white group-focus-within:text-white py-2 focus:outline-none transition-colors"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Servicios</span>
          <svg
            class="w-3.5 h-3.5 text-zinc-400 group-hover:text-white transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          class="dropdown-menu absolute top-full left-0 pt-2 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200 ease-out z-50"
        >
          <div
            class="w-[290px] bg-[#0a0a0a]/95 backdrop-blur-xl border border-white/10 rounded-2xl p-2 shadow-2xl shadow-black/80 flex flex-col gap-1"
          >
            <!-- Automatización -->
            <a
              href="/servicios-automatizacion"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                  <rect x="9" y="9" width="6" height="6"></rect>
                  <path
                    d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"
                  ></path>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Automatización</span
              >
            </a>

            <!-- Desarrollo a medida -->
            <a
              href="/servicios-desarrollo-a-medida"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Desarrollo a medida</span
              >
            </a>

            <!-- Transformación Digital -->
            <a
              href="/servicios-transformacion-digital"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"
                  ></path>
                  <path
                    d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"
                  ></path>
                  <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
                  <path d="M12 9v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Transformación Digital</span
              >
            </a>

            <!-- Sitios web y experiencia digital -->
            <a
              href="/servicios-sitios-web"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Sitios web y experiencia digital</span
              >
            </a>

            <!-- Branding, contenido y redes sociales -->
            <a
              href="/branding-y-contenido"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
                  ></path>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Branding, contenido y redes sociales</span
              >
            </a>
          </div>
        </div>
      </div>

      <!-- Dropdown: Soluciones por Sector -->
      <div class="relative group dropdown-container">
        <button
          type="button"
          class="flex items-center gap-1.5 text-zinc-300 group-hover:text-white group-focus-within:text-white py-2 focus:outline-none transition-colors"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Soluciones por Sector</span>
          <svg
            class="w-3.5 h-3.5 text-zinc-400 group-hover:text-white transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          class="dropdown-menu absolute top-full left-0 pt-2 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200 ease-out z-50"
        >
          <div
            class="w-[290px] bg-[#0a0a0a]/95 backdrop-blur-xl border border-white/10 rounded-2xl p-2 shadow-2xl shadow-black/80 flex flex-col gap-1"
          >
            <!-- Belleza y Estética -->
            <a
              href="/belleza"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
                  ></path>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Belleza y Estética</span
              >
            </a>

            <!-- Construcción e Inmobiliaria -->
            <a
              href="/construccion"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                  <path d="M9 22v-4h6v4"></path>
                  <line x1="8" y1="6" x2="8.01" y2="6"></line>
                  <line x1="16" y1="6" x2="16.01" y2="6"></line>
                  <line x1="8" y1="10" x2="8.01" y2="10"></line>
                  <line x1="16" y1="10" x2="16.01" y2="10"></line>
                  <line x1="8" y1="14" x2="8.01" y2="14"></line>
                  <line x1="16" y1="14" x2="16.01" y2="14"></line>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Construcción e Inmobiliaria</span
              >
            </a>

            <!-- Educación -->
            <a
              href="/educacion"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                  <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"></path>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight">Educación</span>
            </a>

            <!-- Hospitalidad – HORECA -->
            <a
              href="/hospitalidad"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M18 2v6a3 3 0 0 1-3 3 3 3 0 0 1-3-3V2"></path>
                  <path d="M15 11v11"></path>
                  <path d="M5 2v4a3 3 0 0 0 3 3 3 3 0 0 0 3-3V2"></path>
                  <path d="M8 9v13"></path>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Hospitalidad – HORECA</span
              >
            </a>

            <!-- Retail -->
            <a
              href="/retail"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"
                  ></path>
                  <path d="M3 6h18"></path>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight">Retail</span>
            </a>

            <!-- Servicios Profesionales -->
            <a
              href="/servicios-profesionales"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Servicios Profesionales</span
              >
            </a>
          </div>
        </div>
      </div>

      <!-- Dropdown: Portafolios -->
      <div class="relative group dropdown-container">
        <button
          type="button"
          class="flex items-center gap-1.5 text-zinc-300 group-hover:text-white group-focus-within:text-white py-2 focus:outline-none transition-colors"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Portafolios</span>
          <svg
            class="w-3.5 h-3.5 text-zinc-400 group-hover:text-white transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          class="dropdown-menu absolute top-full left-0 pt-2 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200 ease-out z-50"
        >
          <div
            class="w-[290px] bg-[#0a0a0a]/95 backdrop-blur-xl border border-white/10 rounded-2xl p-2 shadow-2xl shadow-black/80 flex flex-col gap-1"
          >
            <!-- Portafolio Branding, Contenido y Redes -->
            <a
              href="/branding-y-contenido"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Portafolio Branding, Contenido y Redes</span
              >
            </a>

            <!-- Portafolio Sitios Web y Experiencias Digitales -->
            <a
              href="/servicios-sitios-web"
              class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-all"
            >
              <span
                class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-zinc-400 group-hover/item:text-[#26CCCA] group-hover/item:bg-[#26CCCA]/10 transition-colors flex-shrink-0"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                  <path d="M3 9h18"></path>
                  <path d="M9 21V9"></path>
                </svg>
              </span>
              <span class="text-xs font-medium leading-tight"
                >Portafolio Sitios Web y Experiencias Digitales</span
              >
            </a>
          </div>
        </div>
      </div>

      <!-- Blog -->
      <a
        href="/blog"
        class="text-zinc-300 hover:text-white transition-colors duration-150 py-2"
      >
        Blog
      </a>
    </nav>

    <!-- Header Actions (Contactar Pill Button) -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="#contacto"
        class="inline-flex items-center justify-center px-5 py-2 rounded-full border border-white/20 bg-white/5 hover:bg-white/10 hover:border-white/40 text-white font-medium text-xs tracking-wide transition-all duration-200"
      >
        Contactar
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Abrir menú de navegación"
      class="lg:hidden p-2 rounded-xl text-white hover:bg-white/10 focus:outline-none transition-colors"
    >
      <svg
        id="menu-icon-open"
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        id="menu-icon-close"
        class="w-6 h-6 hidden"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-b border-white/10 bg-[#030303]/98 backdrop-blur-2xl px-6 py-6 transition-all duration-300 max-h-[85vh] overflow-y-auto"
  >
    <nav
      class="flex flex-col gap-2 font-poppins text-sm font-medium text-zinc-200"
    >
      <!-- Inicio -->
      <a
        href="/"
        class={`mobile-nav-link py-2.5 border-b border-white/5 ${isHome ? "text-[#26CCCA]" : "hover:text-[#26CCCA]"}`}
        >Inicio</a
      >

      <!-- Nosotros -->
      <a
        href="/nosotros"
        class={`mobile-nav-link py-2.5 border-b border-white/5 ${isNosotros ? "text-[#26CCCA]" : "hover:text-[#26CCCA]"}`}
        >Nosotros</a
      >

      <!-- Charlie -->
      <a
        href="https://boosted.cl/charlie.html"
        class="mobile-nav-link py-2.5 border-b border-white/5 hover:text-[#26CCCA]"
        >Charlie</a
      >

      <!-- Mobile Accordion: Servicios -->
      <div class="border-b border-white/5 py-1">
