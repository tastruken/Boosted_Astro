            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Empresa & Contacto (3 Columnas) -->
      <div class="lg:col-span-3 sm:col-span-2">
        <h4 class="font-outfit text-sm font-bold text-white uppercase tracking-wider mb-5">
          Empresa & Contacto
        </h4>
        <ul class="space-y-3 font-poppins text-xs sm:text-sm text-zinc-400 mb-6">
          <li>
            <a href="/nosotros" class="hover:text-[#26CCCA] transition-colors">
