            </a>
          </li>
          <li>
            <a href="/blog" class="hover:text-[#26CCCA] transition-colors">
              Nuestro Blog
            </a>
          </li>
          <li>
            <a href="#charlie" class="hover:text-[#26CCCA] transition-colors text-white font-medium">
              Conoce a Charlie™
            </a>
          </li>
          <li>
            <a href="/branding-y-contenido" class="hover:text-[#26CCCA] transition-colors">
