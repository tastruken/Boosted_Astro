      <div class="flex items-center gap-6 font-medium">
        <a href="https://boosted.cl/politicas-de-privacidad.html" target="_blank" class="hover:text-white transition-colors">Políticas de Privacidad</a>
        <a href="https://boosted.cl/terminos-y-condiciones.html" target="_blank" class="hover:text-white transition-colors">Términos y Condiciones</a>
      </div>
    </div>
