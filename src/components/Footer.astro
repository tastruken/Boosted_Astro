            </a>
          </li>
        </ul>

        <!-- Email Directo de Contacto -->
        <div class="pt-4 border-t border-white/10">
          <a 
            href="mailto:proyectos@boosted.cl" 
            class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-white hover:text-[#26CCCA] transition-colors"
          >
            <svg class="w-4 h-4 text-[#26CCCA]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>proyectos@boosted.cl</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar de Derechos y Enlaces Legales -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-poppins text-zinc-500">
      <div>
        © 2025 <strong class="text-zinc-300 font-medium">Boosted</strong>. Todos los derechos reservados.
