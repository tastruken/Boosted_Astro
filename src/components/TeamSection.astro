---

<section id="equipo" class="relative w-full overflow-hidden bg-[#050507] py-12 md:py-24 lg:py-32 text-white select-none">
  
  <!-- Background Grid (Idéntico al componente proporcionado) -->
  <div class="absolute inset-0 z-0 opacity-5 pointer-events-none">
    <svg class="h-full w-full" fill="none">
      <defs>
        <pattern id="grid" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M20 0L0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5" class="text-zinc-400" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
  </div>

  <div class="container mx-auto grid items-center justify-center gap-8 px-4 text-center md:px-6 relative z-10">
    
    <!-- Header Section (Idéntico al componente UI proporcionado) -->
    <div class="relative z-10 flex w-full flex-col items-center justify-between gap-4 md:flex-row md:items-start md:text-left lg:gap-8">
      <div class="grid gap-2 text-center md:text-left">
        <h2 class="text-4xl font-bold tracking-tighter sm:text-5xl md:text-6xl text-zinc-400 font-outfit uppercase">
          <span class="text-[#26CCCA] block text-xl sm:text-2xl md:text-3xl font-medium tracking-widest font-outfit">
            {tagline}
          </span>
          {title}
        </h2>
        <p class="max-w-[700px] text-zinc-400 md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed font-poppins">
          {description}
        </p>
      </div>
      <div class="flex flex-col items-center gap-4 md:items-end shrink-0">
        <div class="text-2xl sm:text-3xl font-bold font-outfit text-white tracking-wider uppercase flex items-center gap-1.5">
          {brandName}
          <span class="w-2 h-2 rounded-full bg-[#26CCCA]"></span>
        </div>
        {registerLink && (
          <a
            href={registerLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-10 items-center justify-center rounded-md bg-[#26CCCA] hover:bg-[#26CCCA]/90 px-8 text-sm font-medium text-black shadow transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#26CCCA] disabled:pointer-events-none disabled:opacity-50"
          >
            REGISTER NOW
          </a>
        )}
      </div>
    </div>

    <!-- Main Social Links (Idéntico al componente UI) -->
    <div class="relative z-10 flex w-full items-center justify-center gap-4 py-4 md:justify-center text-zinc-400">
      {mainSocialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-[#26CCCA] transition-colors"
          title={link.label}
          set:html={link.icon}
        />
      ))}
      <a
        href={websiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-400 hover:text-[#26CCCA] text-sm transition-colors font-poppins ml-1"
      >
        {websiteText}
      </a>
    </div>

    <!-- Team Members Grid (Basado totalmente en el código enviado, SIN cuadros, con la animación de ola y zoom) -->
    <div class="relative z-10 mx-auto grid w-full max-w-5xl grid-cols-1 gap-8 md:grid-cols-3 lg:gap-12">
      {members.map((member, index) => (
        <div
          class="group relative flex flex-col items-center justify-end overflow-hidden rounded-xl p-6 text-center transition-all duration-300 ease-in-out hover:scale-[1.02]"
        >
          <!-- Background wave animation (La ola desde abajo en hover tal cual tu código) -->
          <div
            class="absolute bottom-0 left-0 right-0 h-1/2 origin-bottom scale-y-0 transform rounded-t-full bg-gradient-to-t from-[#26CCCA]/20 to-transparent transition-transform duration-500 ease-out group-hover:scale-y-100 pointer-events-none"
            style={`transition-delay: ${index * 50}ms`}
          />

          <!-- Member Image with mask and border animation -->
          <div
            class="relative z-10 h-36 w-36 overflow-hidden rounded-full border-4 border-transparent bg-white/5 transition-all duration-500 ease-out group-hover:border-[#26CCCA] group-hover:scale-105"
            style={`transition-delay: ${index * 100}ms`}
          >
            <img
              src={member.imageSrc}
              alt={member.name}
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
            />
          </div>

          <h3 class="relative z-10 mt-4 text-xl font-semibold text-white font-outfit uppercase">
            {member.name}
          </h3>
          <p class="relative z-10 text-sm text-zinc-400 font-poppins">
            {member.designation}
          </p>

          <!-- Social Links for individual members (fade-in en hover) -->
          {member.socialLinks && member.socialLinks.length > 0 && (
            <div class="relative z-10 mt-4 flex gap-3 opacity-0 transition-opacity duration-300 ease-in-out group-hover:opacity-100">
              {member.socialLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-zinc-400 hover:text-[#26CCCA] transition-colors p-1"
                  aria-label={link.label}
                  set:html={link.icon}
                />
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>


