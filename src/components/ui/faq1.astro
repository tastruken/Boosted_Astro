---
// src/components/ui/faq1.astro - FAQ Accordion inspirado en shadcn/ui "faq1" adaptado a Boosted
export interface FAQItem {
  question?: string;
  answer?: string;
  q?: string;
  a?: string;
}

export interface Props {
  faqs?: FAQItem[];
  tagline?: string;
  title?: string;
  titleAccent?: string;
  subtitle?: string;
  defaultValue?: string;
  className?: string;
}

const defaultFaqs: FAQItem[] = [
  {
    q: "¿Realizan desarrollo a código o mantención post-lanzamiento?",
    a: "Nos adaptamos a tu necesidad. Si el proyecto lo requiere, desarrollamos en código a medida. Respecto a la continuidad, ofrecemos flexibilidad total: podemos hacernos cargo de la mantención técnica y actualizaciones de seguridad, o bien, entregar todo el código y la documentación necesaria para que tu equipo interno tome el control total del proyecto."
  },
  {
    q: "¿Los sitios web son autoadministrables?",
    a: "Sí. Desarrollamos sobre plataformas robustas que te permiten editar textos, subir imágenes y crear nuevas entradas de blog sin depender de un programador para cada cambio menor."
  },
  {
    q: "¿Incluyen optimización para móviles?",
    a: "Absolutamente. Aplicamos el enfoque “Mobile First”. Dado que la mayoría del tráfico actual proviene de celulares, aseguramos que la experiencia de usuario sea perfecta en cualquier dispositivo."
  },
  {
    q: "¿Pueden conectar el sitio a mi CRM actual?",
    a: "Claro que sí. Como expertos en automatización, integramos tu web con herramientas como HubSpot, Salesforce, ActiveCampaign, o Google Sheets, para que ningún dato se pierda."
  },
  {
    q: "¿Por qué invertir en Sitios Web y Experiencia Digital?",
    a: "En el mercado actual, la diferencia entre vender y perder un cliente está en la usabilidad. Nuestros servicios de Sitios Web y Experiencia Digital están garantizados para reducir la tasa de rebote. No dejes tu presencia online al azar; agenda una asesoría y llevemos tus Sitios Web y Experiencia Digital al siguiente nivel de conversión."
  }
];

const {
  faqs = defaultFaqs,
  tagline = "",
  title = "PREGUNTAS",
  titleAccent = "FRECUENTES",
  subtitle = "Todo lo que necesitas saber antes de iniciar el desarrollo de tu sitio web y experiencia digital con Boosted.",
  defaultValue = "item-0",
  className = ""
} = Astro.props;

// Normalizar formato de preguntas y respuestas
const normalizedFaqs = faqs.map((faq) => ({
  question: faq.question || faq.q || "",
  answer: faq.answer || faq.a || ""
}));
---

<section id="faq" class={`w-full py-20 sm:py-28 bg-[#FFFFFF] text-[#030303] border-t border-black/[0.06] relative ${className}`}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    
    <!-- Header Centrado Estilo Editorial -->
    <div class="mb-14 sm:mb-16 text-center">
      {tagline && (
        <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
          {tagline}
        </span>
      )}
      
      <h2 class="font-bebas text-5xl sm:text-6xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-4">
        {title} {titleAccent && <span class="border-b-4 border-[#26CCCA] inline-block">{titleAccent}</span>}
      </h2>

      {subtitle && (
        <p class="mx-auto max-w-xl font-poppins text-base text-[#52525B] leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>

    <!-- Accordion Single & Collapsible (Patrón shadcn/ui con CSS Grid & Accesibilidad) -->
    <div 
      class="boosted-accordion divide-y divide-black/10 border-y border-black/10"
      data-default-value={defaultValue}
    >
      {normalizedFaqs.map((faq, index) => {
        const itemId = `item-${index}`;
        const isDefaultOpen = itemId === defaultValue;
        return (
          <div 
            class="accordion-item transition-colors"
            data-state={isDefaultOpen ? "open" : "closed"}
            data-value={itemId}
          >
            <!-- Accordion Trigger Button -->
            <button
              type="button"
              class="accordion-trigger w-full flex items-center justify-between py-5 sm:py-6 text-left group transition-all outline-none focus-visible:ring-2 focus-visible:ring-[#26CCCA] rounded-lg"
              aria-expanded={isDefaultOpen ? "true" : "false"}
              aria-controls={`content-${itemId}`}
              id={`trigger-${itemId}`}
            >
              <span class="font-outfit text-lg sm:text-xl font-bold text-[#030303] group-hover:text-[#0E8A88] transition-colors leading-snug pr-4">
                {faq.question}
              </span>
              
              <!-- Chevron rotativo idéntico a shadcn/ui / radix -->
              <span class="w-8 h-8 rounded-full bg-zinc-100 group-hover:bg-[#26CCCA]/15 flex items-center justify-center shrink-0 transition-colors">
                <svg
                  class="chevron-icon h-4 w-4 shrink-0 text-zinc-500 group-hover:text-[#0E8A88] transition-transform duration-300 pointer-events-none"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </button>

            <!-- Accordion Content Animado con CSS Grid (Zero-lag) -->
            <div
              id={`content-${itemId}`}
              role="region"
              aria-labelledby={`trigger-${itemId}`}
              class="accordion-content overflow-hidden text-[#52525B] transition-all"
            >
              <div class="accordion-inner pb-6 pt-1 font-poppins text-sm sm:text-base leading-relaxed text-[#52525B]">
                {faq.answer}
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  /* CSS Grid Accordion: expansión/colapso ultra fluido sin salto de layout */
  .accordion-content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 300ms cubic-bezier(0.16, 1, 0.3, 1), opacity 200ms ease;
  }

  .accordion-inner {
    overflow: hidden;
  }

  .accordion-item[data-state="open"] .accordion-content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .accordion-item[data-state="open"] .chevron-icon {
    transform: rotate(180deg);
    color: #0E8A88;
  }
</style>

<script>
  function setupAccordions() {
    const accordions = document.querySelectorAll('.boosted-accordion');

    accordions.forEach((accordion) => {
      const items = accordion.querySelectorAll<HTMLElement>('.accordion-item');

      items.forEach((item) => {
        const trigger = item.querySelector<HTMLButtonElement>('.accordion-trigger');
        if (!trigger) return;

        // Evitar duplicar listeners si se re-inicializa
        if (trigger.dataset.initialized === 'true') return;
        trigger.dataset.initialized = 'true';

        trigger.addEventListener('click', () => {
          const isOpen = item.getAttribute('data-state') === 'open';

          // Comportamiento "single collapsible" (cierra los demás hermanos)
          items.forEach((sibling) => {
            if (sibling !== item && sibling.getAttribute('data-state') === 'open') {
              sibling.setAttribute('data-state', 'closed');
              const siblingTrigger = sibling.querySelector<HTMLButtonElement>('.accordion-trigger');
              if (siblingTrigger) siblingTrigger.setAttribute('aria-expanded', 'false');
            }
          });

          // Alternar el actual
          if (isOpen) {
            item.setAttribute('data-state', 'closed');
            trigger.setAttribute('aria-expanded', 'false');
          } else {
            item.setAttribute('data-state', 'open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAccordions);
  } else {
    setupAccordions();
  }
</script>
