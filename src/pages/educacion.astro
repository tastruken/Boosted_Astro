---
// src/pages/educacion.astro - Soluciones por Sector: Instituciones Educativas | Boosted.cl
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import CircularSplitRoll from '../components/CircularSplitRoll.astro';
import HowItWorks from '../components/ui/HowItWorks.astro';

// 3 Pilares Estratégicos de Transformación Digital (Evolución Estratégica)
const strategicPillars = [
  {
    number: "01",
    tag: "CENTRALIZACIÓN & ORDEN",
    title: "Comunicación Fluida",
    description: "Moderniza el contacto con familias mediante un portal centralizado y el asistente Charlie, eliminando definitivamente el caos de WhatsApp y grupos informales.",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
    points: [
      "Portal institucional unificado para apoderados y alumnos",
      "Asistente inteligente Charlie™ resolviendo consultas frecuentes 24/7",
      "Eliminación definitiva del caos de grupos informales y mensajería dispersa"
    ]
  },
  {
    number: "02",
    tag: "MATRÍCULAS & ADMISIONES",
    title: "Captación de Alumnos",
    description: "Asegura una matrícula saludable con una presencia digital profesional y contenido estratégico que posiciona a tu institución como la mejor opción de la zona.",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
    points: [
      "Estrategias de captación y admisiones hipersegmentadas por zona",
      "Posicionamiento en Google para búsquedas de colegios y carreras",
      "Seguimiento automático a familias interesadas hasta el cierre de matrícula"
    ]
  },
  {
    number: "03",
    tag: "REPUTACIÓN & VALOR",
    title: "Diferenciación Clara",
    description: "Proyecta una identidad de excelencia con branding coherente y storytelling emocional que conecta con familias que valoran tu propuesta específica.",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>`,
    points: [
      "Branding institucional que proyecta solvencia, rigor y calidez formativa",
      "Storytelling audiovisual de proyectos educativos, valores e infraestructura",
      "Presentaciones y folletería digital que generan confianza inmediata"
    ]
  }
];

// 6 Subsectores Oficiales de Educación
const subsectors = [
  {
    number: "01",
    title: "Colegios y Liceos",
    description: "Gestión de admisiones, portales de apoderados, difusión de hitos académicos y canales oficiales de comunicación.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`,
    tag: "Escolares & Formativos",
    image: "/mockup/industry_educacion_photo_1786832298593.jpg"
  },
  {
    number: "02",
    title: "Jardines y Salas Cuna",
    description: "Trazabilidad diaria para padres (bitácora de actividades, alimentación y fotos), admisiones tempranas y cercanía humana.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    tag: "Primera Infancia",
    image: "/mockup/light_minimalist_boutique_1786827479127.jpg"
  },
  {
    number: "03",
    title: "Preuniversitarios",
    description: "Plataformas de ensayos en línea, métricas de rendimiento en tiempo real y embudos intensivos de captación para la PAES.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>`,
    tag: "PAES & Rendimiento",
    image: "/mockup/growth_analytics_dark.jpg"
  },
  {
    number: "04",
    title: "Universidades",
    description: "Portales de carreras, campus tours virtuales 3D, captación de pregrado y postgrado con calificación de postulantes por IA.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>`,
    tag: "Educación Superior",
    image: "/mockup/hero_architecture_noir.jpg"
  },
  {
    number: "05",
    title: "Institutos y Centros Técnicos",
    description: "Promoción de carreras técnicas con alta empleabilidad, automatización de matrículas y gestión de convenios.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    tag: "Técnico Profesional",
    image: "/mockup/concept_tech_lab_1786827317224.jpg"
  },
  {
    number: "06",
    title: "Academias de Idiomas",
    description: "Test de nivelación automatizados, agendamiento de clases flexibles y embudos de conversión mensual recurrente.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>`,
    tag: "Idiomas & Especialidades",
    image: "/mockup/light_contrast_studio_1786827514288.jpg"
  }
];

// 6 Razones Oficiales para trabajar con Boosted
const boostedReasons = [
  {
    number: "01",
    title: "Ecosistema Integrado",
    description: "Comunicación, marketing y automatización conectadas sin islas de datos.",
    copy: "Comunicación, marketing y automatización conectadas sin islas de datos.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`
  },
  {
    number: "02",
    title: "Especialización Educación",
    description: "Entendemos a fondo los ciclos de admisión y los procesos internos de las instituciones.",
    copy: "Entendemos a fondo los ciclos de admisión y los procesos internos de las instituciones.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>`
  },
  {
    number: "03",
    title: "Innovación Aplicada",
    description: "VR, AR, recorridos virtuales y simulaciones alineadas a objetivos pedagógicos.",
    copy: "VR, AR, recorridos virtuales y simulaciones alineadas a objetivos pedagógicos.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`
  },
  {
    number: "04",
    title: "Charlie 24/7",
    description: "Optimiza la atención inicial a postulantes y familias en cualquier horario sin descanso.",
    copy: "Optimiza la atención inicial a postulantes y familias en cualquier horario sin descanso.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`
  },
  {
    number: "05",
    title: "Implementación Estratégica",
    description: "Evolución digital ordenada, sin alterar el ritmo del año escolar ni sobrecargar a tus docentes.",
    copy: "Evolución digital ordenada, sin alterar el ritmo del año escolar ni sobrecargar a tus docentes.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  },
  {
    number: "06",
    title: "Enfoque en Resultados",
    description: "Mejor experiencia para las familias, retención de alumnos y mayor conversión de matrícula.",
    copy: "Mejor experiencia para las familias, retención de alumnos y mayor conversión de matrícula.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>`
  }
];
---

<Layout 
  title="Estrategia y Gestión para Instituciones Educativas | Boosted.cl"
  description="Colegios, jardines infantiles, preuniversitarios, institutos, academias y universidades que operan con ecosistemas digitales logran una comunicación fluida con apoderados. Diferenciación institucional clara."
>
  <Navbar />

  <main class="flex-grow">

    <!-- 1. HERO SECTION (Negro Obsidiana #050505 con Acentos Cian & Estilo Editorial Idéntico a Belleza y Construcción) -->
    <section class="min-h-[calc(100vh-80px)] bg-[#050505] text-white relative flex items-center px-6 sm:px-12 lg:px-20 py-12 lg:py-16 overflow-hidden select-none">
      
      <!-- Fondo Cinematográfico y Texturas de Profundidad con Imagen del Campus y Viñetas -->
      <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden">
        <img 
          src="/mockup/industry_educacion_photo_1786832298593.jpg" 
          alt="Boosted Educación Texture" 
          class="w-full h-full object-cover object-right lg:object-center opacity-25 brightness-90 contrast-125 scale-105"
          loading="eager"
          decoding="async"
        />
        <!-- Viñetas de gradiente oficiales -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-80"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/60 to-transparent opacity-90"></div>
        <div class="absolute top-1/3 left-1/4 w-[500px] h-[350px] bg-[#26CCCA]/15 rounded-full blur-[160px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[300px] bg-[#0E8A88]/20 rounded-full blur-[180px]"></div>
      </div>

      <!-- Contenido Principal en Grilla de 2 Columnas -->
      <div class="w-full max-w-[1400px] mx-auto relative z-10 py-6 sm:py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna Izquierda: Titulares, Narrativa y CTAs (7 Columnas) -->
          <div class="lg:col-span-7 flex flex-col justify-center">

            <!-- Eyebrow Editorial Limpio -->
            <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
              Soluciones por Sector · Instituciones Educativas
            </span>

            <!-- Titular Proporcionado e Impactante con Gradiente Oficial -->
            <h1 class="font-bebas text-4xl sm:text-6xl lg:text-[4.6rem] text-white tracking-tight uppercase leading-[0.95] mb-4">
              ESTRATEGIA Y GESTIÓN PARA<br />
              <span class="bg-gradient-to-r from-[#26CCCA] via-[#3DE8E5] to-[#0E8A88] bg-clip-text text-transparent">
                INSTITUCIONES EDUCATIVAS
              </span>
            </h1>

            <!-- Párrafo Claro y Respirable -->
            <p class="font-poppins text-sm sm:text-base lg:text-lg text-zinc-300 font-normal leading-relaxed max-w-xl mb-6">
              Colegios, jardines infantiles, preuniversitarios, institutos, academias y universidades que operan con ecosistemas digitales logran una comunicación fluida con apoderados. Diferenciación institucional clara.
            </p>

            <!-- Botones de Acción Inmediatos -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-6">
              <!-- CTA 1: Agenda Diagnóstico Gratuito -->
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-3.5 px-7 inline-flex items-center justify-center gap-2.5 border border-white/20 shadow-lg text-center cursor-pointer"
              >
                <span>Agenda Diagnóstico Gratuito</span>
                <svg class="w-4 h-4 text-[#26CCCA] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </a>

              <!-- CTA 2: Ver Cómo Funciona -->
              <a 
                href="#subsectores" 
                class="px-7 py-3.5 rounded-full border border-white/20 bg-white/[0.05] hover:bg-white/[0.12] hover:border-[#26CCCA] text-white font-outfit text-xs font-bold uppercase tracking-wider transition-all duration-200 inline-flex items-center justify-center gap-2 text-center cursor-pointer"
              >
                <span>Ver Cómo Funciona</span>
                <span class="text-[#26CCCA]">↓</span>
              </a>
            </div>

          </div>

          <!-- Columna Derecha: Enfoque Estratégico en Estilo Editorial Abierto (Sin cajas pesadas) -->
          <div class="lg:col-span-5 flex flex-col justify-center gap-8 lg:gap-10 lg:pl-6">
            
            <!-- Pilar 1: Comunicación & Familias -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Comunicación & Apoderados
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Cero Ruido en WhatsApp
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-white group-hover:text-[#26CCCA] transition-colors leading-none tracking-tight shrink-0">
                  100%
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Centralización de consultas, comunicados y pagos en canales institucionales seguros y ordenados.
              </p>
            </div>

            <!-- Divisor sutil entre pilares -->
            <div class="h-px w-full bg-gradient-to-r from-white/10 via-white/5 to-transparent"></div>

            <!-- Pilar 2: Captación & Matrículas -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Admisiones & Matrículas
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Conversión de Matrículas
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-[#26CCCA] leading-none tracking-tight shrink-0">
                  +2.8x
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Embudos de admisión con Charlie™ que atienden a padres y postulantes 24/7 sin perder familias interesadas.
              </p>
            </div>

          </div>

        </div>
      </div>

    </section>

    <!-- 2. TRANSFORMACIÓN DIGITAL (Blanco Puro #FFFFFF con Tarjetas de Lujo, Exactamente como Belleza y Construcción) -->
    <section id="transformacion" class="py-24 sm:py-32 bg-[#FFFFFF] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            TRANSFORMACIÓN DIGITAL
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            TRANSFORMACIÓN DIGITAL PARA <br class="hidden sm:block" />
            <span class="border-b-4 border-[#26CCCA] inline-block">EL SECTOR DE EDUCACIÓN</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            Las soluciones digitales para educación transforman la forma en que operan colegios, jardines infantiles, preuniversitarios, institutos, academias y universidades. Las instituciones que las implementan logran una comunicación organizada con apoderados y estudiantes, captación constante de nuevos alumnos y una diferenciación clara en un mercado educativo cada vez más competitivo.
          </p>
        </div>

        <!-- Grilla de los 3 Pilares Estratégicos con Luxury Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          {strategicPillars.map((pillar) => (
            <div class="luxury-card group flex flex-col justify-between p-8 sm:p-10 rounded-3xl bg-[#F8F9FA] border border-zinc-200 hover:border-[#26CCCA] hover:-translate-y-1 transition-all duration-300 relative min-h-[380px] shadow-sm hover:shadow-xl">
              <div>
                <!-- Top Row: Icono + Número Gigante -->
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
                  <div class="w-12 h-12 rounded-2xl bg-white border border-zinc-200 flex items-center justify-center group-hover:bg-[#26CCCA]/10 transition-colors" set:html={pillar.icon}>
                  </div>
                  <span class="font-bebas text-4xl text-zinc-300 group-hover:text-[#26CCCA] transition-colors leading-none">
                    {pillar.number}
                  </span>
                </div>

                <!-- Tag Editorial Limpio -->
                <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
                  {pillar.tag}
                </span>

                <!-- Título -->
                <h3 class="font-outfit text-2xl font-bold text-[#030303] mb-4 leading-tight">
                  {pillar.title}
                </h3>

                <!-- Descripción -->
                <p class="font-poppins text-sm text-[#52525B] leading-relaxed mb-6">
                  {pillar.description}
                </p>
              </div>

              <!-- Puntos Clave con checkmark limpio -->
              <div class="pt-4 border-t border-black/5 space-y-2 font-poppins text-xs text-zinc-600">
                {pillar.points.map((point) => (
                  <div class="flex items-center gap-2">
                    <span class="text-[#26CCCA] font-bold text-xs shrink-0">✓</span>
                    <span>{point}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 3. SUBSECTORES: APLICACIONES POR TIPO DE INSTITUCIÓN (3D Circular Split Roll Interactivo) -->
    <CircularSplitRoll 
      items={subsectors} 
      subtitle="Soluciones adaptadas a las dinámicas formativas, administrativas y de admisión de cada tipo de institución educativa:"
      footerNote="Ecosistemas digitales sincronizados para el sector educativo"
      badgeText="6 Especialidades Adaptadas"
    />

    <!-- 4. DIGITAL SIGNAGE: PANTALLAS INTELIGENTES PARA EDUCACIÓN (Negro Obsidiana #030303) -->
    <section id="digital-signage" class="py-20 sm:py-28 bg-[#030303] text-white border-y border-white/10 relative overflow-hidden">
      <!-- Glow ambiental suave -->
