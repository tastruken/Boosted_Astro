<Layout 
  title="Branding, Contenido y Redes: Portafolio y Estrategias que Venden | Boosted.cl"
  description="Selección de proyectos donde transformamos la identidad visual y el ecosistema digital de nuestros clientes. Construimos marcas con autoridad y comunicación estratégica orientada a la venta."
>
  <Navbar />

  <main class="flex-grow">

    <!-- 1. HERO SECTION (Negro Obsidiana #050505 con Acentos Cian & Estilo Editorial) -->
    <section class="min-h-[calc(100vh-80px)] bg-[#050505] text-white relative flex items-center px-6 sm:px-12 lg:px-20 py-12 lg:py-16 overflow-hidden select-none">
      
      <!-- Fondo Cinematográfico y Texturas de Profundidad -->
      <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden">
        <img 
          src="/mockup/hero_marketing_cinema.jpg" 
          alt="Boosted Branding y Contenido Texture" 
          class="w-full h-full object-cover object-right lg:object-center opacity-25 brightness-90 contrast-125 scale-105"
          loading="eager"
          decoding="async"
        />
        <!-- Viñetas de gradiente -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-80"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/60 to-transparent opacity-90"></div>
        <div class="absolute top-1/3 left-1/4 w-[500px] h-[350px] bg-[#26CCCA]/15 rounded-full blur-[160px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[300px] bg-[#0E8A88]/20 rounded-full blur-[180px]"></div>
      </div>

      <!-- Contenido Principal en Grilla de 2 Columnas -->
      <div class="w-full max-w-[1400px] mx-auto relative z-10 py-6 sm:py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna Izquierda: Titulares, Narrativa y CTAs (7 Columnas) -->
          <div class="lg:col-span-7 flex flex-col justify-center">

            <!-- Tag / Eyebrow -->
            <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
              Branding · Contenido · Redes Sociales
            </span>

            <!-- Titular Proporcionado e Impactante -->
            <h1 class="font-bebas text-4xl sm:text-6xl lg:text-[4.6rem] text-white tracking-tight uppercase leading-[0.95] mb-4">
              PORTAFOLIO Y ESTRATEGIAS<br />
              <span class="bg-gradient-to-r from-[#26CCCA] via-[#3DE8E5] to-[#0E8A88] bg-clip-text text-transparent">
                QUE VENDEN
              </span>
            </h1>

            <!-- Párrafo Claro y Respirable -->
            <p class="font-poppins text-sm sm:text-base lg:text-lg text-zinc-300 font-normal leading-relaxed max-w-xl mb-6">
              Selección de proyectos donde transformamos la <strong class="text-white font-medium">identidad visual y el ecosistema digital</strong> de nuestros clientes. En Boosted, no solo diseñamos logotipos o publicamos posts en redes sociales; construimos ecosistemas digitales coherentes.
            </p>

            <!-- Botones de Acción Inmediatos -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-6">
              <!-- CTA 1: Hablemos sobre mi marca y contenido -->
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-3.5 px-7 inline-flex items-center justify-center gap-2.5 border border-white/20 shadow-lg text-center"
              >
                <span>Hablemos sobre mi marca y contenido</span>
                <svg class="w-4 h-4 text-[#26CCCA] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </a>

              <!-- CTA 2: Ver Proyectos -->
              <a 
                href="#portafolio" 
                class="px-7 py-3.5 rounded-full border border-white/20 bg-white/[0.05] hover:bg-white/[0.12] hover:border-[#26CCCA] text-white font-outfit text-xs font-bold uppercase tracking-wider transition-all duration-200 inline-flex items-center justify-center gap-2 text-center"
              >
                <span>Ver Proyectos</span>
                <span class="text-[#26CCCA]">↓</span>
              </a>
            </div>

          </div>

          <!-- Columna Derecha: Enfoque Estratégico en Estilo Editorial Abierto (Sin cajas ni recuadros) -->
          <div class="lg:col-span-5 flex flex-col justify-center gap-8 lg:gap-10 lg:pl-6">
            
            <!-- Pilar 1: Identidad de Autoridad -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Identidad Visual
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Imagen de Autoridad
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-white group-hover:text-[#26CCCA] transition-colors leading-none tracking-tight shrink-0">
                  100%
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Modernizamos la imagen corporativa de tu empresa conservando su esencia y proyectando liderazgo ante mandantes y clientes.
              </p>
            </div>

            <!-- Divisor sutil entre pilares -->
            <div class="h-px w-full bg-gradient-to-r from-white/10 via-white/5 to-transparent"></div>

            <!-- Pilar 2: Contenido que Vende -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Contenido Estratégico
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Activos que Convierten
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-[#26CCCA] leading-none tracking-tight shrink-0">
                  360°
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Calendarios editoriales de interacción real, lookbooks y presentaciones comerciales diseñadas para acelerar y cerrar ventas.
              </p>
            </div>

          </div>

        </div>
      </div>

    </section>

    <!-- 2. CASOS DE ÉXITO: PROYECTOS QUE HABLAN POR SÍ SOLOS (Blanco Puro #FFFFFF) -->
    <section id="portafolio" class="py-24 sm:py-32 bg-[#FFFFFF] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            CASOS DE ÉXITO
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            PROYECTOS QUE HABLAN <span class="border-b-4 border-[#26CCCA] inline-block">POR SÍ SOLOS</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            A continuación, verás cómo hemos ayudado a empresas de Salud, Tecnología, Educación e industria a transformar su presencia digital.
          </p>
        </div>

        <!-- Grilla de los 20 Casos de Éxito en 3 Columnas con NotchedProjectCard -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10 mb-16">
          {portfolioProjects.map((project) => (
            <NotchedProjectCard
              href={project.href}
              title={project.title}
              description={project.description}
              image={project.image}
              imageAlt={`Caso ${project.title}`}
              category={project.category}
              number={project.number}
              tags={[project.tag, project.featuredBadge]}
              surface="#FFFFFF"
            />
          ))}
        </div>

        <!-- Banner de Conversión: ¿Quieres resultados similares? -->
        <div class="rounded-3xl bg-[#050505] text-white p-8 sm:p-12 border border-white/10 relative overflow-hidden shadow-xl">
          <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-[#26CCCA]/10 rounded-full blur-3xl pointer-events-none"></div>
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            <div class="lg:col-span-8">
              <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
                RESULTADOS COMPROBADOS
              </span>
              <p class="font-outfit text-xl sm:text-2xl lg:text-3xl font-bold text-white leading-snug">
                "¿Quieres resultados similares? <span class="text-[#26CCCA]">Conversemos</span> y diseñemos una identidad y estrategia de contenido que posicione a tu empresa como líder."
              </p>
            </div>
            <div class="lg:col-span-4 flex lg:justify-end">
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-4 px-8 inline-flex items-center gap-2 border border-white/20 whitespace-nowrap"
              >
                <span>Hablemos de tu Proyecto</span>
                <svg class="w-4 h-4 text-[#26CCCA]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3. NUESTRA METODOLOGÍA: ¿CÓMO INTEGRAMOS BRANDING, CONTENIDO Y REDES? (Gris Muy Claro #F8F9FA) -->
    <section id="metodologia" class="py-24 sm:py-32 bg-[#F8F9FA] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            NUESTRA METODOLOGÍA
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            ¿CÓMO INTEGRAMOS BRANDING, CONTENIDO <span class="border-b-4 border-[#26CCCA] inline-block">Y REDES EN BOOSTED?</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            No creemos en las soluciones parche. Muchos clientes llegan habiendo contratado un logo por un lado y un Community Manager por otro, resultando en una imagen fracturada. Nuestra metodología unifica estos mundos en tres etapas diseñadas para la coherencia y la conversión:
          </p>
        </div>

        <!-- Grilla de las 3 Etapas de Metodología -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          {methodologyStages.map((stage) => (
            <div class="luxury-card group flex flex-col justify-between p-8 sm:p-10 rounded-3xl bg-white border border-zinc-200 hover:border-[#26CCCA] hover:-translate-y-1 transition-all duration-300 relative min-h-[380px] shadow-sm hover:shadow-xl">
              <div>
                <!-- Top Row: Icono + Número Gigante -->
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
                  <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center group-hover:bg-[#26CCCA]/10 transition-colors" set:html={stage.icon}>
                  </div>
                  <span class="font-bebas text-4xl text-zinc-300 group-hover:text-[#26CCCA] transition-colors leading-none">
                    {stage.stage}
                  </span>
                </div>

                <!-- Badge de Etapa -->
                <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
                  {stage.badge}
                </span>

                <!-- Título de la Etapa -->
                <h3 class="font-outfit text-2xl font-bold text-[#030303] mb-4 leading-tight">
                  {stage.title}
                </h3>

                <!-- Descripción Completa Oficial -->
                <p class="font-poppins text-sm text-[#52525B] leading-relaxed mb-6">
                  {stage.description}
                </p>
              </div>

              <!-- Puntos Clave de la Etapa -->
              <div class="pt-4 border-t border-black/5 space-y-2 font-poppins text-xs text-zinc-600">
                {stage.keyPoints.map((point) => (
                  <div class="flex items-center gap-2">
                    <span class="text-[#26CCCA] font-bold text-xs shrink-0">✓</span>
                    <span>{point}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. ECOSISTEMA UNIFICADO: ¿POR QUÉ TU EMPRESA NECESITA UN ECOSISTEMA UNIFICADO? (Negro Obsidiana #030303) -->
    <section id="ecosistema-unificado" class="py-16 sm:py-20 lg:py-24 bg-[#030303] text-white border-y border-white/10 relative overflow-hidden">
      <!-- Glows ambientales sutiles -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#26CCCA]/10 rounded-full blur-[180px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-10 w-72 h-72 bg-[#26CCCA]/5 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Header de Sección -->
        <div class="max-w-2xl mx-auto text-center mb-12 sm:mb-16">
          <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-2">
            ECOSISTEMA UNIFICADO
          </span>
          <h2 class="font-bebas text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight uppercase leading-[0.95] mb-3">
            ¿POR QUÉ TU EMPRESA NECESITA <span class="text-[#26CCCA]">UN ECOSISTEMA UNIFICADO?</span>
          </h2>
          <p class="font-poppins text-xs sm:text-sm text-zinc-400 leading-relaxed max-w-lg mx-auto">
            El mercado digital de hoy está saturado. Para destacar, la consistencia es la clave. Un servicio aislado de redes sociales puede generar ruido momentáneo, pero sin una identidad de marca sólida ese ruido no construye lealtad a largo plazo.
          </p>
        </div>

        <!-- 3 Pilares del Ecosistema Unificado -->
        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/10 mb-14 pt-6 border-t border-white/10">
          
          {ecosystemPillars.map((pillar) => (
            <div class="py-8 md:py-4 md:px-6 lg:px-8 flex flex-col group first:md:pl-0 last:md:pr-0">
              <div class="flex items-center justify-between mb-4">
                <span class="font-bebas text-3xl sm:text-4xl text-[#26CCCA] group-hover:text-white transition-colors leading-none">
                  {pillar.number}
                </span>
                <span class="px-2.5 py-1 rounded-full bg-white/[0.04] text-[11px] font-outfit uppercase font-bold text-[#26CCCA] border border-white/10 group-hover:border-[#26CCCA]/40 transition-colors">
                  {pillar.metric}
                </span>
              </div>
              <h3 class="font-outfit text-xl font-bold text-white mb-2 group-hover:text-[#26CCCA] transition-colors leading-tight">
                {pillar.title}
              </h3>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 leading-relaxed mb-4 flex-grow">
                {pillar.detail}
              </p>
              <div class="pt-3 border-t border-white/5 text-[11px] font-outfit uppercase font-semibold text-zinc-400 flex items-center gap-1.5">
                <span class="text-[#26CCCA] font-bold text-xs">✓</span>
                <span>{pillar.metricLabel}</span>
              </div>
            </div>
          ))}

        </div>

        <!-- Bloque Inferior de Conversión & CTAs -->
        <div class="max-w-xl mx-auto text-center">
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-4">
            <a 
              href={calendarUrl}
              target="_blank" 
              rel="noopener noreferrer"
              class="btn-primary text-xs uppercase tracking-wider py-3.5 px-7 inline-flex items-center justify-center gap-2 border border-white/20 shadow-xl text-center w-full sm:w-auto"
            >
              <span>AGENDAR UNA ASESORÍA GRATUITA</span>
              <svg class="w-3.5 h-3.5 text-[#26CCCA]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </a>

            <a 
              href="#contacto" 
              class="px-7 py-3.5 rounded-full border border-white/20 bg-white/[0.05] hover:bg-white/[0.12] hover:border-[#26CCCA] text-white font-outfit text-xs font-bold uppercase tracking-wider transition-all duration-200 inline-flex items-center justify-center gap-2 text-center w-full sm:w-auto"
            >
              <span>Hablar con un Asesor</span>
              <span class="text-[#26CCCA]">↓</span>
            </a>
          </div>

          <!-- Indicadores de Confianza Micro-reaseguro -->
          <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-[11px] font-outfit text-zinc-400">
            <span class="inline-flex items-center gap-1.5">
              <span class="text-[#26CCCA] font-bold">✓</span>
              Sesión estratégica de 30 minutos
            </span>
            <span class="inline-flex items-center gap-1.5">
              <span class="text-[#26CCCA] font-bold">✓</span>
              Diagnóstico de marca y canales
            </span>
            <span class="inline-flex items-center gap-1.5">
              <span class="text-[#26CCCA] font-bold">✓</span>
              Sin compromiso
            </span>
          </div>
        </div>

      </div>
    </section>


    <!-- 6. PREGUNTAS FRECUENTES (FAQ) (Diseño shadcn/ui faq1 Accordion) -->
    <FAQ1 
      faqs={faqs} 
      tagline="PREGUNTAS FRECUENTES"
      title="PREGUNTAS"
      titleAccent="FRECUENTES"
      subtitle="Preguntas frecuentes sobre nuestros servicios de Branding, Contenido y Redes Sociales."
    />


    <!-- 8. CONTACTO REUTILIZADO (Componente Oficial Contact.astro con Formulario y Canales) -->
    <Contact />

  </main>

  <Footer />
</Layout>
