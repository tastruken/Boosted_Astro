---
// src/pages/servicios-desarrollo-a-medida.astro - Página Oficial "Desarrollo a Medida" de Boosted (boosted.cl)
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

// 6 Formas de cómo aplicamos desarrollo a medida en tu ecosistema digital
const customDevSolutions = [
  {
    number: "01",
    badge: "Operación Diaria",
    title: "Aplicaciones internas",
    description: "Herramientas web o paneles internos que simplifican tareas diarias: formularios, gestores de solicitudes, portales de clientes. Diseñadas para cómo TU equipo trabaja.",
    tech: "Portales Web, Formularios & Gestores",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>`
  },
  {
    number: "02",
    badge: "Escalabilidad Modular",
    title: "Módulos y extensiones",
    description: "Extensiones que potencian lo que ya usas (CRM, ERP), agregando funcionalidades específicas. Escala sin migrar todo tu sistema.",
    tech: "Add-ons para CRM, ERP & Billing",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" /></svg>`
  },
  {
    number: "03",
    badge: "Cero Fricción",
    title: "Conectores de integración",
    description: "Soluciones que permiten que tus sistemas “hablen” entre sí cuando no existen integraciones nativas. Elimina el copia/pega y errores manuales.",
    tech: "Custom APIs & Sync Bidireccional",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>`
  },
  {
    number: "04",
    badge: "Visibilidad Total",
    title: "Paneles de control",
    description: "Interfaces a medida para visualizar indicadores clave, combinando datos de distintas fuentes en una experiencia clara para tu equipo.",
    tech: "Dashboards en Vivo & Business Intelligence",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`
  },
  {
    number: "05",
    badge: "Liberación Operativa",
    title: "Portales para aliados",
    description: "Espacios digitales donde clientes o aliados autogestionan procesos, conectados a tu automatización y datos para liberar carga operativa.",
    tech: "Portales de Clientes & Proveedores B2B",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`
  },
  {
    number: "06",
    badge: "Validación Rápida",
    title: "MVP y prototipos",
    description: "Desarrollo rápido de versiones iniciales para validar ideas antes de escalar. Valida con datos reales y menor inversión inicial.",
    tech: "Prototipado Ágil & Validación de Mercado",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`
  }
];

// Beneficios de trabajar con Boosted
const benefits = [
  {
    number: "01",
    title: "Procesos más simples y fluidos",
    highlight: "La herramienta se ajusta a tu forma de trabajar, no al revés.",
    detail: "Diseñamos flujos y pantallas que calzan de manera natural con la operativa real de tu equipo, eliminando fricciones y acelerando la adopción desde el primer día."
  },
  {
    number: "02",
    title: "Mejor integración con tu ecosistema",
    highlight: "Tus automatizaciones y tus fuentes de datos trabajando en armonía.",
    detail: "Sin islas de información aisladas. Cada desarrollo a medida se integra nativamente con tus CRMs, ERPs, bases de datos y workflows existentes."
  },
  {
    number: "03",
    title: "Mayor productividad del equipo",
    highlight: "Eliminando pasos innecesarios y fricción en sistemas.",
    detail: "Menos clics y cero digitación duplicada. Tu equipo recupera horas críticas para enfocarse en tareas que realmente mueven la aguja del negocio."
  },
  {
    number: "04",
    title: "Mayor control sobre la evolución",
    highlight: "Total independencia, sin depender de software genérico.",
    detail: "Eres dueño del 100% de la propiedad intelectual de tus herramientas. Puedes escalarlas, adaptarlas y agregar funciones cuando lo requieras sin ataduras a licencias mensuales."
  }
];

const calendarUrl = "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ0eLzWvh-yrlAvDqP4vCBpex5c2wtzqpp89n_C4VVp6Obx184OHVTcQxAJBAtq4CtJtcYmyMuuA";
---

<Layout 
  title="Desarrollo a Medida — Soluciones Digitales Integradas | Boosted.cl"
  description="Desarrollo a medida que conecta tus sistemas, automatización y datos para que funcionen como un solo ecosistema digital. El problema no es falta de tecnología, es que sistemas genéricos no calzan con tu proceso único."
>
  <Navbar />

  <main class="flex-grow">

    <!-- 1. HERO SECTION (Negro Obsidiana #050505 con Acentos Cian & Distribución Equilibrada en 2 Columnas) -->
    <section class="min-h-[calc(100vh-80px)] bg-[#050505] text-white relative flex items-center px-6 sm:px-12 lg:px-20 py-12 lg:py-16 overflow-hidden select-none">
      
      <!-- Fondo Cinematográfico y Texturas de Profundidad -->
      <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden">
        <img 
          src="/mockup/hero_pilar_software.jpg" 
          alt="Boosted Custom Development Texture" 
          class="w-full h-full object-cover object-right lg:object-center opacity-30 brightness-90 contrast-125 scale-105"
        />
        <!-- Viñetas de gradiente que dejan visible la imagen de fondo -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-80"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/40 to-transparent opacity-85"></div>
        <div class="absolute top-1/3 left-1/4 w-[500px] h-[350px] bg-[#26CCCA]/15 rounded-full blur-[160px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[300px] bg-[#0E8A88]/20 rounded-full blur-[180px]"></div>
      </div>

      <!-- Contenido Principal en Grilla de 2 Columnas -->
      <div class="w-full max-w-[1400px] mx-auto relative z-10 py-6 sm:py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna Izquierda: Titulares, Narrativa y CTAs (7 Columnas) -->
          <div class="lg:col-span-7 flex flex-col justify-center">

            <!-- Titular Proporcionado e Impactante -->
            <h1 class="font-bebas text-4xl sm:text-6xl lg:text-[4.6rem] text-white tracking-tight uppercase leading-[0.95] mb-4">
              SOLUCIONES DIGITALES A MEDIDA<br />
              <span class="bg-gradient-to-r from-[#26CCCA] via-[#3DE8E5] to-[#0E8A88] bg-clip-text text-transparent">
                INTEGRADAS A TU ECOSISTEMA
              </span>
            </h1>

            <!-- Párrafo Claro y Respirable -->
            <p class="font-poppins text-sm sm:text-base lg:text-lg text-zinc-300 font-normal leading-relaxed max-w-xl mb-6">
              Desarrollo a medida que conecta tus sistemas, automatización y datos para que funcionen como un solo ecosistema digital. El problema no es “falta de tecnología”, es que <strong class="text-white font-medium">sistemas genéricos no calzan con tu proceso único</strong>.
            </p>

            <!-- Botones de Acción Inmediatos -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
              <!-- CTA 1: Agenda Diagnóstico Gratuito -->
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-3.5 px-7 inline-flex items-center justify-center gap-2.5 border border-white/20 shadow-lg text-center"
              >
                <span>Agenda Diagnóstico Gratuito</span>
                <svg class="w-4 h-4 text-[#26CCCA] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </a>

              <!-- CTA 2: Agendar Asesoría Gratuita -->
              <a 
                href={calendarUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-7 py-3.5 rounded-full border border-white/20 bg-white/[0.05] hover:bg-white/[0.12] hover:border-[#26CCCA] text-white font-outfit text-xs font-bold uppercase tracking-wider transition-all duration-200 inline-flex items-center justify-center gap-2 text-center"
              >
                <span>Agendar Asesoría Gratuita</span>
                <svg class="w-4 h-4 text-[#26CCCA] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </a>
            </div>

          </div>

          <!-- Columna Derecha: Métricas en Estilo Editorial Abierto (Sin cajas ni recuadros) -->
          <div class="lg:col-span-5 flex flex-col justify-center gap-8 lg:gap-10 lg:pl-6">
            
            <!-- Métrica 1: 85% Tasa de Adopción -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Diseño Adaptado
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Tasa de Adopción
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-white group-hover:text-[#26CCCA] transition-colors leading-none tracking-tight shrink-0">
                  85%
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Herramientas diseñadas para cómo TU equipo trabaja realmente, eliminando la fricción y resistencia al cambio.
              </p>
            </div>

            <!-- Divisor sutil entre métricas -->
            <div class="h-px w-full bg-gradient-to-r from-white/10 via-white/5 to-transparent"></div>

            <!-- Métrica 2: 100% Ownership Total -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Control Absoluto
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Ownership Total
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-[#26CCCA] leading-none tracking-tight shrink-0">
                  100%
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Propiedad intelectual y código fuente propios. Evolución técnica continua sin ataduras a licencias mensuales.
              </p>
            </div>

          </div>

        </div>
      </div>

    </section>

    <!-- 2. CÓMO APLICAMOS DESARROLLO A MEDIDA (Blanco Puro #FFFFFF) -->
    <section id="aplicacion-desarrollo" class="py-24 sm:py-32 bg-[#FFFFFF] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            CÓMO APLICAMOS DESARROLLO A MEDIDA EN TU ECOSISTEMA DIGITAL
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            SOLUCIONES CONECTADAS <span class="border-b-4 border-[#26CCCA] inline-block">A TU OPERACIÓN</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            El desarrollo a medida cubre distintas necesidades dentro de tu negocio. Aquí te mostramos cómo implementamos soluciones conectadas a tu ecosistema digital y automatización.
          </p>
        </div>

        <!-- Grilla de las 6 Formas de Aplicación -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-16">
          {customDevSolutions.map((solution) => (
            <div class="luxury-card group flex flex-col justify-between p-8 rounded-3xl bg-white border border-zinc-200 hover:border-[#26CCCA] hover:-translate-y-1 transition-all duration-300 relative min-h-[320px]">
              <div>
                <!-- Top Row: Icono + Número Grande -->
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
                  <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center group-hover:bg-[#26CCCA]/10 transition-colors" set:html={solution.icon}>
                  </div>
                  <span class="font-bebas text-4xl text-zinc-300 group-hover:text-[#26CCCA] transition-colors leading-none">
                    {solution.number}
                  </span>
                </div>

                <!-- Título del Método -->
                <h3 class="font-outfit text-2xl font-bold text-[#030303] mb-3 leading-tight">
                  {solution.title}
                </h3>

                <!-- Descripción Oficial del Bloque -->
                <p class="font-poppins text-sm text-[#52525B] leading-relaxed mb-6">
                  {solution.description}
                </p>
              </div>

              <!-- Footer de la Tarjeta: Badge de Precisión & Stack -->
              <div class="pt-4 border-t border-black/5 flex items-center justify-between text-xs font-outfit">
                <span class="inline-flex items-center gap-1.5 uppercase font-bold text-[#0E8A88]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#26CCCA]"></span>
                  {solution.badge}
                </span>
                <span class="text-zinc-400 font-medium">{solution.tech}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Quote / Statement de Enfoque Estratégico de Boosted -->
        <div class="rounded-3xl bg-[#050505] text-white p-8 sm:p-12 border border-white/10 relative overflow-hidden shadow-xl">
          <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-[#26CCCA]/10 rounded-full blur-3xl pointer-events-none"></div>
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            <div class="lg:col-span-8">
              <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
                FILOSOFÍA DE DESARROLLO BOOSTED
              </span>
              <p class="font-outfit text-xl sm:text-2xl lg:text-3xl font-bold text-white leading-snug">
                "En Boosted diseñamos herramientas que <span class="text-[#26CCCA]">entienden cómo trabaja tu equipo</span>, integradas con tus sistemas actuales y con total control sobre su evolución."
              </p>
            </div>
            <div class="lg:col-span-4 flex lg:justify-end">
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-4 px-8 inline-flex items-center gap-2 border border-white/20 whitespace-nowrap"
              >
                <span>Diagnosticar mis requerimientos</span>
                <svg class="w-4 h-4 text-[#26CCCA]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3. BENEFICIOS DE TRABAJAR CON BOOSTED (Gris Muy Claro #F8F9FA) -->
    <section id="beneficios" class="py-24 sm:py-32 bg-[#F8F9FA] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            BENEFICIOS DE TRABAJAR CON BOOSTED
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            LO QUE GANAS CON SOLUCIONES <span class="border-b-4 border-[#26CCCA] inline-block">DISEÑADAS PARA TU REALIDAD</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            Lo que ganas con soluciones diseñadas para tu realidad:
          </p>
        </div>

        <!-- Grilla de Beneficios en 4 Tarjetas de Lujo -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          {benefits.map((b) => (
            <div class="luxury-card group flex flex-col justify-between p-8 rounded-3xl bg-white border border-zinc-200 hover:border-[#26CCCA] hover:-translate-y-1 transition-all duration-300 relative min-h-[300px]">
              <div>
                <!-- Top: Número + Checkmark -->
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
                  <span class="font-bebas text-4xl text-zinc-300 group-hover:text-[#26CCCA] transition-colors leading-none">
                    {b.number}
                  </span>
                  <div class="w-8 h-8 rounded-full bg-[#26CCCA]/15 text-[#0E8A88] flex items-center justify-center font-bold text-sm">
                    ✓
                  </div>
                </div>

                <!-- Título del Beneficio -->
                <h3 class="font-outfit text-xl sm:text-2xl font-bold text-[#030303] mb-3 leading-snug">
                  {b.title}
                </h3>

                <!-- Highlight Oficial -->
                <p class="font-poppins text-sm font-semibold text-[#0E8A88] mb-3">
                  {b.highlight}
                </p>

                <!-- Detalle Contextual -->
                <p class="font-poppins text-xs text-[#52525B] leading-relaxed">
                  {b.detail}
                </p>
              </div>

              <!-- Footer Indicator -->
              <div class="pt-4 border-t border-black/5 flex items-center gap-2 text-xs font-outfit uppercase font-semibold text-[#0E8A88]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#26CCCA]"></span>
                <span>Eficiencia Operativa Real</span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. ¿POR QUÉ DESARROLLAR CON BOOSTED? (Negro Obsidiana #030303) -->
    <section id="por-que-desarrollar" class="py-16 sm:py-20 lg:py-24 bg-[#030303] text-white border-y border-white/10 relative overflow-hidden">
      <!-- Glows ambientales sutiles -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#26CCCA]/10 rounded-full blur-[180px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-10 w-72 h-72 bg-[#26CCCA]/5 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Header de Sección Compacto y Centrado -->
        <div class="max-w-2xl mx-auto text-center mb-10 sm:mb-12">
          <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-2">
            VENTAJA ESTRATÉGICA
          </span>
          <h2 class="font-bebas text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight uppercase leading-[0.95] mb-3">
            ¿POR QUÉ DESARROLLAR CON <span class="text-[#26CCCA]">BOOSTED</span>?
          </h2>
          <p class="font-poppins text-xs sm:text-sm text-zinc-400 leading-relaxed max-w-lg mx-auto">
            Combinamos experiencia en diseño de experiencia digital, automatización y desarrollo para crear soluciones que se integran con tus objetivos de negocio.
          </p>
        </div>

        <!-- Grilla de los 2 Grandes Pilares -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 mb-10 sm:mb-12">
          
          <!-- Pilar 01: Sinergia de Diseño, Automatización y Código -->
          <div class="group relative rounded-2xl sm:rounded-3xl bg-[#080808] border border-white/10 hover:border-[#26CCCA]/50 p-6 sm:p-7 lg:p-8 transition-all duration-300 flex flex-col justify-between overflow-hidden shadow-xl hover:-translate-y-1">
            <!-- Línea luminosa superior en hover -->
            <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-[#26CCCA]/30 to-transparent group-hover:via-[#26CCCA] transition-all duration-500"></div>
            
            <div>
