---
// src/pages/blog.astro - Página Oficial del Blog | Boosted.cl
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { featuredPost, blogPosts } from '../data/blog';

const categories = [
  "Todos",
  "Diseño Web",
  "Automatización",
  "Estrategia",
  "Branding",
  "Marketing Digital"
];
---

<Layout 
  title="El Pulso de la Transformación Digital | Blog Boosted.cl"
  description="Exploramos la intersección entre diseño estratégico, tecnología de vanguardia y automatización inteligente para potenciar el crecimiento de tu negocio."
>
  <Navbar />

  <main class="flex-grow">

    <!-- 1. HERO SECTION DEL BLOG (Negro Obsidiana #050505 con Acentos Cian) -->
    <section class="min-h-[460px] lg:min-h-[520px] bg-[#050505] text-white relative flex items-center px-6 sm:px-12 lg:px-20 py-20 lg:py-24 overflow-hidden select-none">
      
      <!-- Fondos de textura ambiental difusa -->
      <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden">
        <div class="absolute top-1/4 left-1/3 w-[600px] h-[350px] bg-[#26CCCA]/12 rounded-full blur-[170px]"></div>
        <div class="absolute bottom-10 right-1/4 w-[400px] h-[300px] bg-[#0E8A88]/15 rounded-full blur-[160px]"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-90"></div>
      </div>

      <div class="w-full max-w-[1400px] mx-auto relative z-10">
        <div class="max-w-3xl">
          <!-- Eyebrow Editorial -->
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
            PUBLICACIONES & ANÁLISIS ESTRATÉGICO
          </span>

          <!-- Titular Principal -->
          <h1 class="font-bebas text-5xl sm:text-7xl lg:text-8xl text-white tracking-tight uppercase leading-[0.92] mb-5">
            EL PULSO DE LA<br />
            <span class="bg-gradient-to-r from-[#26CCCA] via-[#3DE8E5] to-[#0E8A88] bg-clip-text text-transparent">
              TRANSFORMACIÓN DIGITAL
            </span>
          </h1>

          <!-- Párrafo Descriptivo -->
          <p class="font-poppins text-base sm:text-lg lg:text-xl text-zinc-300 font-normal leading-relaxed max-w-2xl mb-8">
            Exploramos la intersección entre diseño estratégico, tecnología de vanguardia y automatización inteligente para potenciar el crecimiento de tu negocio.
          </p>

          <!-- Filtro de Categorías -->
          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            {categories.map((cat, i) => (
              <span 
                class={`font-outfit text-xs font-semibold px-4 py-2 rounded-full border transition-all cursor-pointer ${
                  i === 0 
                    ? 'bg-[#26CCCA] text-[#030303] border-[#26CCCA]' 
                    : 'bg-white/5 text-zinc-300 border-white/10 hover:border-[#26CCCA] hover:text-white'
                }`}
              >
                {cat}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. ARTÍCULO DESTACADO (Layout Horizontal de Lujo) -->
    <section class="py-16 sm:py-20 bg-white border-b border-black/[0.06] relative">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <div class="flex items-center gap-3 mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-[#26CCCA]"></span>
          <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88]">
            Artículo Destacado de Portada
          </span>
        </div>

        <a 
          href={featuredPost.href} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group block rounded-3xl bg-[#070708] text-white border border-white/10 overflow-hidden shadow-2xl hover:border-[#26CCCA]/50 transition-all duration-500"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
            
            <!-- Columna Izquierda: Información Editorial y Contenido (7 Cols) -->
            <div class="lg:col-span-7 p-8 sm:p-12 lg:p-14 flex flex-col justify-between relative z-10">
              <div>
                <!-- Badges Superiores -->
                <div class="flex flex-wrap items-center gap-3 mb-6">
                  <span class="px-3 py-1 rounded-full bg-[#26CCCA] text-[#030303] font-outfit text-xs font-bold uppercase tracking-wider">
                    ★ Destacado
                  </span>
                  <span class="px-3 py-1 rounded-full bg-white/10 text-[#26CCCA] font-outfit text-xs font-semibold tracking-wider">
                    {featuredPost.category}
                  </span>
                  <span class="text-xs font-poppins text-zinc-400">
                    {featuredPost.date}
                  </span>
                  <span class="text-xs font-poppins text-zinc-400">
                    • {featuredPost.readTime}
                  </span>
                </div>

                <!-- Título -->
                <h2 class="font-outfit text-2xl sm:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight tracking-tight group-hover:text-[#26CCCA] transition-colors">
                  {featuredPost.title}
                </h2>

                <!-- Excerpt -->
                <p class="font-poppins text-sm sm:text-base text-zinc-300 leading-relaxed mb-8 max-w-2xl">
                  {featuredPost.excerpt}
                </p>
              </div>

              <!-- CTA con Flecha -->
              <div class="pt-6 border-t border-white/10 flex items-center justify-between">
                <span class="font-outfit text-sm font-bold uppercase tracking-wider text-[#26CCCA] flex items-center gap-2 group-hover:translate-x-1 transition-transform">
                  <span>Leer artículo completo</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
                <span class="text-xs font-poppins text-zinc-400">Análisis profundo & ROI</span>
              </div>
            </div>

            <!-- Columna Derecha: Imagen de Portada con Zoom Suave (5 Cols) -->
            <div class="lg:col-span-5 relative min-h-[300px] sm:min-h-[380px] lg:min-h-full overflow-hidden bg-black/40">
              <img 
                src={featuredPost.image} 
                alt={featuredPost.title} 
                class="w-full h-full object-cover object-center brightness-95 group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#070708] via-transparent to-transparent opacity-60 lg:opacity-40"></div>
            </div>

          </div>
        </a>

      </div>
    </section>

    <!-- 3. GRILLA DE ARTÍCULOS RECIENTES (Luxury Editorial Cards #F8F9FA) -->
    <section class="py-20 sm:py-28 bg-[#FFFFFF] relative">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
          <div>
            <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88] block mb-2">
              ARTÍCULOS Y ANÁLISIS
            </span>
            <h2 class="font-bebas text-4xl sm:text-6xl text-[#030303] tracking-tight uppercase leading-none">
              PUBLICACIONES <span class="border-b-4 border-[#26CCCA] inline-block">RECIENTES</span>
            </h2>
          </div>
          <p class="font-poppins text-sm text-[#52525B] max-w-md leading-relaxed">
            Estrategias accionables, tendencias de inteligencia artificial y metodologías de automatización para escalar tu rentabilidad.
          </p>
        </div>

        <!-- Grilla de Tarjetas -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {blogPosts.map((post) => (
            <a 
              href={post.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group p-8 sm:p-9 rounded-3xl bg-[#F8F9FA] border border-zinc-200 hover:border-[#26CCCA] hover:bg-white hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
            >
              <div>
                <!-- Top Row: Categoría y Tiempo de Lectura -->
                <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-black/5">
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88]">
                    {post.category}
                  </span>
                  <div class="flex items-center gap-2 text-xs font-poppins text-zinc-400">
                    <span>{post.date}</span>
                    <span>•</span>
                    <span>{post.readTime}</span>
                  </div>
                </div>

                <!-- Título del Artículo -->
                <h3 class="font-outfit text-xl sm:text-2xl font-bold text-[#030303] mb-4 group-hover:text-[#0E8A88] transition-colors leading-snug">
                  {post.title}
                </h3>

                <!-- Descripción / Extracto -->
                <p class="font-poppins text-sm text-[#52525B] leading-relaxed mb-6">
                  {post.excerpt}
                </p>
              </div>

              <!-- Footer de la Tarjeta -->
              <div class="pt-5 border-t border-black/5 flex items-center justify-between">
                <span class="font-outfit text-xs font-bold uppercase tracking-wider text-[#030303] group-hover:text-[#26CCCA] flex items-center gap-1.5 transition-colors">
                  <span>Leer más</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </span>
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-200 group-hover:bg-[#26CCCA] transition-colors"></span>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. BANNER DE CONVERSIÓN INFERIOR CON CHARLIE -->
    <section class="pb-24 bg-white">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-8 lg:px-12">
        <div class="rounded-3xl bg-[#070708] text-white border border-white/10 relative overflow-hidden shadow-2xl group">
          <div class="absolute -right-20 -top-20 w-96 h-96 bg-[#26CCCA]/10 rounded-full blur-3xl pointer-events-none"></div>

          <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch relative z-10">
            <!-- Columna Izquierda: Charlie estudiando -->
            <div class="lg:col-span-5 relative w-full min-h-[340px] sm:min-h-[400px] overflow-hidden">
              <div class="absolute -top-12 -left-12 w-80 h-80 bg-[#26CCCA]/15 rounded-full blur-3xl pointer-events-none"></div>
              <img 
                src="/mockup/charlie_studying_robot.jpg" 
                alt="Charlie™ - Analista y Estratega de Contenidos Boosted" 
                class="w-full h-full object-cover object-center brightness-[1.05] contrast-[1.02] transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-y-0 right-0 w-24 sm:w-36 bg-gradient-to-r from-transparent to-[#070708] pointer-events-none hidden lg:block"></div>
              <div class="absolute inset-x-0 bottom-0 h-16 sm:h-24 bg-gradient-to-t from-[#070708] to-transparent pointer-events-none lg:hidden"></div>
            </div>

            <!-- Columna Derecha: CTA -->
            <div class="lg:col-span-7 p-8 sm:p-12 lg:p-14 flex flex-col justify-center">
              <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
                APLICA ESTAS ESTRATEGIAS EN TU EMPRESA
              </span>

              <h3 class="font-outfit text-2xl sm:text-3xl lg:text-4xl font-bold text-white leading-tight mb-4 tracking-tight">
                ¿Listo para transformar tus visitas en clientes y automatizar tus operaciones?
              </h3>

              <p class="font-poppins text-sm sm:text-base text-zinc-300 leading-relaxed mb-8 max-w-xl">
                Agenda un diagnóstico estratégico gratuito con nuestro equipo. Analizamos tus procesos actuales y diseñamos el ecosistema digital a la medida de tus metas.
              </p>

              <div>
                <a 
                  href="#contacto"
                  class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-white text-[#030303] font-outfit font-bold text-xs uppercase tracking-wider hover:bg-[#26CCCA] hover:text-[#030303] transition-all duration-300 shadow-xl hover:shadow-[0_0_30px_rgba(38,204,202,0.4)] group cursor-pointer"
                >
                  <span>Agenda Diagnóstico Gratuito</span>
                  <svg class="w-4 h-4 text-[#030303] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. CONTACTO REUTILIZADO (Componente Oficial Contact.astro) -->
    <Contact />

  </main>

  <Footer />
</Layout>
