    description: "Presupuestos transparentes, seguimiento fotográfico por etapas y cotizadores interactivos para clientes residenciales y comerciales.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>`,
    tag: "Reformas & Interiorismo",
    image: "/mockup/hero_architecture_noir.jpg"
  },
  {
    number: "03",
    title: "Instalaciones Técnicas",
    description: "Gestión de cuadrillas, partes diarios digitales y trazabilidad de certificaciones eléctricas, sanitarias o de climatización.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    tag: "Ingeniería & Faena",
    image: "/mockup/automation_pipeline_mockup.jpg"
  },
  {
    number: "04",
    title: "Inmobiliarias",
    description: "Salas de venta digitales, renders interactivos 3D, stock de unidades en tiempo real y embudos de prospección para inversionistas.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>`,
    tag: "Desarrollos & Ventas",
    image: "/mockup/hero_architecture_noir.webp"
  },
  {
    number: "05",
    title: "Corretaje",
    description: "Catálogos dinámicos de propiedades, visitas virtuales 360°, automatización de captación de propietarios y calificación de compradores.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>`,
    tag: "Propiedades & Cierres",
    image: "/mockup/growth_analytics_dark.jpg"
  },
  {
    number: "06",
    title: "Administradoras",
    description: "Portales de condominios y edificios, gestión de gastos comunes, reportería de mantenciones y comunicación centralizada.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
    tag: "Comunidades & Edificios",
    image: "/mockup/digital_ecosystem_mockup.jpg"
  }
];

// 6 Razones Oficiales para trabajar con Boosted
const boostedReasons = [
  {
    number: "01",
    title: "Ecosistema Integrado",
    description: "CRM, portal proyectado y marketing conectados sin silos de información.",
    copy: "CRM, portal proyectado y marketing conectados sin silos de información.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`
  },
  {
    number: "02",
    title: "Especialización Sector",
    description: "Diseño exclusivo para construcción e inmobiliaria con flujos comerciales probados.",
    copy: "Diseño exclusivo para construcción e inmobiliaria con flujos comerciales probados.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`
  },
  {
    number: "03",
    title: "Implementación Gradual",
    description: "Evolución sin detener tus proyectos comerciales ni alterar el ritmo diario de faena.",
    copy: "Evolución sin detener tus proyectos comerciales ni alterar el ritmo diario de faena.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`
  },
  {
    number: "04",
    title: "Solución 360°",
    description: "Gestión trazable + Captación leads + Marca premium para dominar tu mercado.",
    copy: "Gestión trazable + Captación leads + Marca premium para dominar tu mercado.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>`
  },
  {
    number: "05",
    title: "Soporte Especializado",
    description: "Acompañamiento que entiende la complejidad técnica y comercial del sector.",
    copy: "Acompañamiento que entiende la complejidad técnica y comercial del sector.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`
  },
  {
    number: "06",
    title: "Autonomía de Datos",
    description: "Información de proyectos y clientes siempre bajo tu propiedad y control total.",
    copy: "Información de proyectos y clientes siempre bajo tu propiedad y control total.",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  }
];
---

<Layout 
  title="Estrategia y Gestión para Construcción e Inmobiliaria | Boosted.cl"
  description="Impulsa tu empresa con soluciones digitales que garantizan trazabilidad total, optimizan la captación de clientes y aseguran una diferenciación profesional clara en un mercado competitivo."
>
  <Navbar />

  <main class="flex-grow">

    <!-- 1. HERO SECTION (Negro Obsidiana #050505 con Acentos Cian & Estilo Editorial Idéntico a Belleza) -->
    <section class="min-h-[calc(100vh-80px)] bg-[#050505] text-white relative flex items-center px-6 sm:px-12 lg:px-20 py-12 lg:py-16 overflow-hidden select-none">
      
      <!-- Fondo Cinematográfico y Texturas de Profundidad con Imagen y Viñetas -->
      <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden">
        <img 
          src="/mockup/industry_construccion_1786829732825.jpg" 
          alt="Boosted Construcción e Inmobiliaria Texture" 
          class="w-full h-full object-cover object-right lg:object-center opacity-25 brightness-90 contrast-125 scale-105"
          loading="eager"
          decoding="async"
        />
        <!-- Viñetas de gradiente oficiales -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-80"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/60 to-transparent opacity-90"></div>
        <div class="absolute top-1/3 left-1/4 w-[500px] h-[350px] bg-[#26CCCA]/15 rounded-full blur-[160px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[300px] bg-[#0E8A88]/20 rounded-full blur-[180px]"></div>
      </div>

      <!-- Contenido Principal en Grilla de 2 Columnas -->
      <div class="w-full max-w-[1400px] mx-auto relative z-10 py-6 sm:py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna Izquierda: Titulares, Narrativa y CTAs (7 Columnas) -->
          <div class="lg:col-span-7 flex flex-col justify-center">

            <!-- Eyebrow Editorial Limpio (Sin líneas duras ni recuadros) -->
            <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
              Soluciones por Sector · Construcción e Inmobiliaria
            </span>

            <!-- Titular Proporcionado e Impactante con Gradiente Oficial -->
            <h1 class="font-bebas text-4xl sm:text-6xl lg:text-[4.6rem] text-white tracking-tight uppercase leading-[0.95] mb-4">
              ESTRATEGIA Y GESTIÓN PARA<br />
              <span class="bg-gradient-to-r from-[#26CCCA] via-[#3DE8E5] to-[#0E8A88] bg-clip-text text-transparent">
                CONSTRUCCIÓN E INMOBILIARIA
              </span>
            </h1>

            <!-- Párrafo Claro y Respirable -->
            <p class="font-poppins text-sm sm:text-base lg:text-lg text-zinc-300 font-normal leading-relaxed max-w-xl mb-6">
              Impulsa tu empresa con soluciones digitales que garantizan trazabilidad total, optimizan la captación de clientes y aseguran una diferenciación profesional clara en un mercado competitivo.
            </p>

            <!-- Botones de Acción Inmediatos -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-6">
              <!-- CTA 1: Agenda Diagnóstico Gratuito -->
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-3.5 px-7 inline-flex items-center justify-center gap-2.5 border border-white/20 shadow-lg text-center cursor-pointer"
              >
                <span>Agenda Diagnóstico Gratuito</span>
                <svg class="w-4 h-4 text-[#26CCCA] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </a>

              <!-- CTA 2: Ver Cómo Funciona -->
              <a 
                href="#subsectores" 
                class="px-7 py-3.5 rounded-full border border-white/20 bg-white/[0.05] hover:bg-white/[0.12] hover:border-[#26CCCA] text-white font-outfit text-xs font-bold uppercase tracking-wider transition-all duration-200 inline-flex items-center justify-center gap-2 text-center cursor-pointer"
              >
                <span>Ver Cómo Funciona</span>
                <span class="text-[#26CCCA]">↓</span>
              </a>
            </div>

          </div>

          <!-- Columna Derecha: Enfoque Estratégico en Estilo Editorial Abierto (Sin cajas pesadas) -->
          <div class="lg:col-span-5 flex flex-col justify-center gap-8 lg:gap-10 lg:pl-6">
            
            <!-- Pilar 1: Trazabilidad en Tiempo Real -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Control & Faena
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Trazabilidad Total
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-white group-hover:text-[#26CCCA] transition-colors leading-none tracking-tight shrink-0">
                  100%
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Portales de clientes con avances de obra certificados, fotos e hitos en tiempo real para eliminar fricciones y reclamos.
              </p>
            </div>

            <!-- Divisor sutil entre pilares -->
            <div class="h-px w-full bg-gradient-to-r from-white/10 via-white/5 to-transparent"></div>

            <!-- Pilar 2: Captación & Cierre Comercial -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Ventas & Prospección
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Leads Calificados
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-[#26CCCA] leading-none tracking-tight shrink-0">
                  +3.4x
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Estrategias de adquisición y embudos comerciales con IA que atraen compradores calificados e inversionistas serios.
              </p>
            </div>

          </div>

        </div>
      </div>

    </section>

    <!-- 2. TRANSFORMACIÓN DIGITAL (Blanco Puro #FFFFFF con Tarjetas de Lujo, Exactamente como Belleza) -->
    <section id="transformacion" class="py-24 sm:py-32 bg-[#FFFFFF] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            TRANSFORMACIÓN DIGITAL
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            TRANSFORMACIÓN DIGITAL PARA <br class="hidden sm:block" />
            <span class="border-b-4 border-[#26CCCA] inline-block">CONSTRUCCIÓN E INMOBILIARIA</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            Las soluciones digitales transforman la forma en que operan constructoras, inmobiliarias y corredores de propiedades. Gestiona proyectos con trazabilidad total y mejora radicalmente la experiencia del comprador final.
          </p>
        </div>

        <!-- Grilla de los 3 Pilares Estratégicos con Luxury Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          {strategicPillars.map((pillar) => (
            <div class="luxury-card group flex flex-col justify-between p-8 sm:p-10 rounded-3xl bg-[#F8F9FA] border border-zinc-200 hover:border-[#26CCCA] hover:-translate-y-1 transition-all duration-300 relative min-h-[380px] shadow-sm hover:shadow-xl">
              <div>
                <!-- Top Row: Icono + Número Gigante -->
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
                  <div class="w-12 h-12 rounded-2xl bg-white border border-zinc-200 flex items-center justify-center group-hover:bg-[#26CCCA]/10 transition-colors" set:html={pillar.icon}>
                  </div>
                  <span class="font-bebas text-4xl text-zinc-300 group-hover:text-[#26CCCA] transition-colors leading-none">
                    {pillar.number}
                  </span>
                </div>

                <!-- Tag Editorial Limpio -->
                <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
                  {pillar.tag}
                </span>

                <!-- Título -->
                <h3 class="font-outfit text-2xl font-bold text-[#030303] mb-4 leading-tight">
                  {pillar.title}
                </h3>

                <!-- Descripción -->
                <p class="font-poppins text-sm text-[#52525B] leading-relaxed mb-6">
                  {pillar.description}
                </p>
              </div>

              <!-- Puntos Clave con checkmark limpio -->
              <div class="pt-4 border-t border-black/5 space-y-2 font-poppins text-xs text-zinc-600">
                {pillar.points.map((point) => (
                  <div class="flex items-center gap-2">
                    <span class="text-[#26CCCA] font-bold text-xs shrink-0">✓</span>
                    <span>{point}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 3. SUBSECTORES: APLICACIONES POR TIPO DE NEGOCIO (3D Circular Split Roll Interactivo) -->
    <CircularSplitRoll 
      items={subsectors} 
      subtitle="Ecosistemas adaptados a las dinámicas operativas y comerciales de constructoras, inmobiliarias y corredores de propiedades:"
      footerNote="Ecosistemas digitales sincronizados para el sector de construcción e inmobiliaria"
      badgeText="6 Especialidades Adaptadas"
    />

    <!-- 4. DIGITAL SIGNAGE: PANTALLAS INTELIGENTES QUE TRANSFORMAN ESPACIOS (Negro Obsidiana #030303) -->
    <section id="digital-signage" class="py-20 sm:py-28 bg-[#030303] text-white border-y border-white/10 relative overflow-hidden">
      <!-- Glow ambiental suave -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#26CCCA]/10 rounded-full blur-[180px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-10 w-80 h-80 bg-[#26CCCA]/5 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-[1400px] mx-auto px-4 sm:px-8 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          
          <!-- Columna Izquierda: Información de Digital Signage (7 Cols) -->
