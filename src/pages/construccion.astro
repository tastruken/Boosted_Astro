    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>`,
    points: [
      "Campañas hipersegmentadas por zona geográfica y plusvalía",
      "Posicionamiento orgánico en Google para búsqueda de proyectos",
      "Embudos de prospección automatizados con WhatsApp e IA"
    ]
  },
  {
    number: "03",
    tag: "REPUTACIÓN & EXPERTISE",
    title: "Solidez de Marca",
    description: "Identidad visual premium que proyecta solvencia y expertise, permitiendo cobrar precios de mercado sin regateos.",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`,
