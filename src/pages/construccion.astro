---
// src/pages/construccion.astro - Soluciones por Sector: Construcción e Inmobiliaria | Boosted.cl
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import CircularSplitRoll from '../components/CircularSplitRoll.astro';
import HowItWorks from '../components/ui/HowItWorks.astro';

// 3 Pilares Estratégicos de Transformación Digital (Evolución Estratégica)
const strategicPillars = [
  {
    number: "01",
    tag: "CONTROL & TRANSPARENCIA",
    title: "Trazabilidad de Proyectos",
    description: "Portal de clientes con avances en tiempo real: hitos, fotos y presupuestos transparentes para reducir fricciones y mejorar la confianza.",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>`,
