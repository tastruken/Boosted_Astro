<Layout 
  title="Soluciones Digitales para Servicios Profesionales | Boosted.cl"
  description="El ecosistema para escalar tu firma. En Boosted diseñamos soluciones digitales para consultoras, estudios jurídicos, contables y asesorías que integran captación, proyectos y gestión operativa."
>
  <Navbar />

  <main class="flex-grow">

    <!-- 1. HERO SECTION (Negro Obsidiana #050505 con Acentos Cian & Estilo Editorial Boosted) -->
    <section class="min-h-[calc(100vh-80px)] bg-[#050505] text-white relative flex items-center px-6 sm:px-12 lg:px-20 py-12 lg:py-16 overflow-hidden select-none">
      
      <!-- Fondo Cinematográfico y Texturas de Profundidad con Fotografía Corporativa -->
      <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden">
        <img 
          src="/mockup/industry_servicios_1786829835822.jpg" 
          alt="Boosted Servicios Profesionales Texture" 
          class="w-full h-full object-cover object-right lg:object-center opacity-25 brightness-90 contrast-125 scale-105"
          loading="eager"
          decoding="async"
        />
        <!-- Viñetas de gradiente oficiales -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-80"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/60 to-transparent opacity-90"></div>
        <div class="absolute top-1/3 left-1/4 w-[500px] h-[350px] bg-[#26CCCA]/15 rounded-full blur-[160px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[300px] bg-[#0E8A88]/20 rounded-full blur-[180px]"></div>
      </div>

      <!-- Contenido Principal en Grilla de 2 Columnas -->
      <div class="w-full max-w-[1400px] mx-auto relative z-10 py-6 sm:py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna Izquierda: Titulares, Narrativa y CTAs (7 Columnas) -->
          <div class="lg:col-span-7 flex flex-col justify-center">

            <!-- Eyebrow Editorial Limpio -->
            <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
              Soluciones por Sector · Servicios Profesionales
            </span>

            <!-- Titular Proporcionado e Impactante con Gradiente Oficial -->
            <h1 class="font-bebas text-4xl sm:text-6xl lg:text-[4.6rem] text-white tracking-tight uppercase leading-[0.95] mb-4">
              SOLUCIONES DIGITALES PARA<br />
              <span class="bg-gradient-to-r from-[#26CCCA] via-[#3DE8E5] to-[#0E8A88] bg-clip-text text-transparent">
                SERVICIOS PROFESIONALES
              </span>
            </h1>

            <!-- Párrafo Claro y Respirable -->
            <p class="font-poppins text-sm sm:text-base lg:text-lg text-zinc-300 font-normal leading-relaxed max-w-xl mb-6">
              El ecosistema para escalar tu firma. Diseñamos soluciones digitales que integran cada área de tu negocio, desde la captación de clientes hasta la gestión operativa final. Ecosistemas específicos para consultoras, estudios jurídicos, contables y asesorías.
            </p>

            <!-- Botones de Acción Inmediatos -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-6">
              <!-- CTA 1: Agenda Diagnóstico Gratuito -->
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-3.5 px-7 inline-flex items-center justify-center gap-2.5 border border-white/20 shadow-lg text-center cursor-pointer"
              >
                <span>Agenda Diagnóstico Gratuito</span>
                <svg class="w-4 h-4 text-[#26CCCA] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </a>

              <!-- CTA 2: Ver Cómo Funciona -->
              <a 
                href="#subsectores" 
                class="px-7 py-3.5 rounded-full border border-white/20 bg-white/[0.05] hover:bg-white/[0.12] hover:border-[#26CCCA] text-white font-outfit text-xs font-bold uppercase tracking-wider transition-all duration-200 inline-flex items-center justify-center gap-2 text-center cursor-pointer"
              >
                <span>Ver Cómo Funciona</span>
                <span class="text-[#26CCCA]">↓</span>
              </a>
            </div>

          </div>

          <!-- Columna Derecha: Enfoque Estratégico en Estilo Editorial Abierto -->
          <div class="lg:col-span-5 flex flex-col justify-center gap-8 lg:gap-10 lg:pl-6">
            
            <!-- Pilar 1: Pipeline Comercial & Seguimiento -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Pipeline Comercial
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Trazabilidad de Oportunidades
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-white group-hover:text-[#26CCCA] transition-colors leading-none tracking-tight shrink-0">
                  100%
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Seguimiento automático de propuestas y oportunidades comerciales sin fugas de prospectos ni tareas manuales.
              </p>
            </div>

            <!-- Divisor sutil entre pilares -->
            <div class="h-px w-full bg-gradient-to-r from-white/10 via-white/5 to-transparent"></div>

            <!-- Pilar 2: Diferenciación & Clientes Premium -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Posicionamiento & Autoridad
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Clientes de Alto Valor
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-[#26CCCA] leading-none tracking-tight shrink-0">
                  +2.6x
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Marca digital que proyecta solvencia técnica y permite defender honorarios basados en valor demostrado.
              </p>
            </div>

          </div>

        </div>
      </div>

    </section>

    <!-- 2. TRANSFORMACIÓN DE FIRMAS (Blanco Puro #FFFFFF con Comparativa de Lujo & Luxury Cards) -->
    <section id="transformacion" class="py-24 sm:py-32 bg-[#FFFFFF] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            TRANSFORMACIÓN DE FIRMAS
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            TRANSFORMACIÓN DIGITAL EN <br class="hidden sm:block" />
            <span class="border-b-4 border-[#26CCCA] inline-block">EMPRESAS PROFESIONALES</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            Empresas que implementan ecosistemas digitales completos logran un pipeline comercial organizado, proyectos con visibilidad real y una diferenciación clara que permite cobrar por el valor demostrado.
          </p>
        </div>

        <!-- A. COMPARATIVA ESTRATÉGICA (Sobria, limpia, sin cuadros rojos genéricos) -->
        <div id="cambio" class="mb-20 scroll-mt-24">
          <div class="max-w-2xl mb-8">
            <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88] block mb-2">
              COMPARATIVA DE MODELOS
            </span>
            <h3 class="font-bebas text-3xl sm:text-5xl text-[#030303] tracking-tight uppercase leading-none">
              Operación Tradicional vs <span class="border-b-4 border-[#26CCCA] inline-block">Ecosistema Boosted</span>
            </h3>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">
            
            <!-- Columna Izquierda: Modelo Tradicional (El Desafío) -->
            <div class="rounded-3xl bg-[#F8F9FA] border border-zinc-200 p-8 sm:p-10 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-6 mb-6 border-b border-black/5">
                  <div>
                    <span class="font-outfit text-xs font-semibold uppercase tracking-wider text-zinc-400 block mb-1">
                      El Desafío Actual
                    </span>
                    <h4 class="font-outfit text-2xl font-bold text-zinc-800">
                      Operación Tradicional de Firmas
                    </h4>
                  </div>
                  <span class="text-xs font-outfit font-semibold px-3 py-1 rounded-full bg-zinc-200/80 text-zinc-600">
                    Silos Operativos
                  </span>
                </div>

                <div class="space-y-6">
                  {comparisonTradicional.map((item) => (
                    <div class="flex items-start gap-4">
                      <div class="w-7 h-7 rounded-full bg-zinc-200/70 text-zinc-500 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
                        —
                      </div>
                      <div>
                        <strong class="font-outfit text-base font-semibold text-zinc-900 block mb-1">
                          {item.title}
                        </strong>
                        <p class="font-poppins text-xs sm:text-sm text-zinc-500 leading-relaxed">
                          {item.desc}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="pt-6 mt-8 border-t border-black/5 flex items-center justify-between text-xs font-poppins text-zinc-400">
                <span>Dependencia de referencias casuales</span>
                <span class="font-semibold text-zinc-600">Fugas de horas y propuestas sin cerrar</span>
              </div>
            </div>

            <!-- Columna Derecha: Con Ecosistema Boosted (La Solución) -->
            <div class="rounded-3xl bg-[#050505] text-white border border-[#26CCCA]/30 p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden shadow-2xl">
              <!-- Glow ambiental sutil -->
              <div class="absolute -top-20 -right-20 w-72 h-72 bg-[#26CCCA]/15 rounded-full blur-3xl pointer-events-none"></div>

              <div class="relative z-10">
                <div class="flex items-center justify-between pb-6 mb-6 border-b border-white/10">
                  <div>
                    <span class="font-outfit text-xs font-bold uppercase tracking-wider text-[#26CCCA] block mb-1">
                      Solución Boosted
                    </span>
                    <h4 class="font-outfit text-2xl font-bold text-white">
                      Con Ecosistema Coherente e Integrado
                    </h4>
                  </div>
                  <span class="text-xs font-outfit font-bold px-3 py-1 rounded-full bg-[#26CCCA]/20 text-[#26CCCA] border border-[#26CCCA]/40">
                    Escala Predecible
                  </span>
                </div>

                <div class="space-y-6">
                  {comparisonBoosted.map((item) => (
                    <div class="flex items-start gap-4">
                      <div class="w-7 h-7 rounded-full bg-[#26CCCA]/20 text-[#26CCCA] border border-[#26CCCA]/40 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
                        ✓
                      </div>
                      <div>
                        <strong class="font-outfit text-base font-semibold text-white block mb-1">
                          {item.title}
                        </strong>
                        <p class="font-poppins text-xs sm:text-sm text-zinc-300 leading-relaxed">
                          {item.desc}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="relative z-10 pt-6 mt-8 border-t border-white/10 flex items-center justify-between text-xs font-poppins text-zinc-400">
                <span class="text-[#26CCCA] font-semibold">Trazabilidad completa</span>
                <span class="font-semibold text-white">Autoridad y honorarios por valor</span>
              </div>
            </div>

          </div>
        </div>

        <!-- B. LO QUE HACEMOS (Nuestros 3 Pilares con Luxury Cards) -->
        <div class="mb-20">
          <div class="flex items-center gap-3 mb-8">
            <span class="w-2.5 h-2.5 rounded-full bg-[#26CCCA]"></span>
            <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88]">
              Lo Que Hacemos · Nuestra Metodología
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            {strategicPillars.map((pillar) => (
              <div class="luxury-card group flex flex-col justify-between p-8 sm:p-10 rounded-3xl bg-[#F8F9FA] border border-zinc-200 hover:border-[#26CCCA] hover:-translate-y-1 transition-all duration-300 relative min-h-[380px] shadow-sm hover:shadow-xl">
                <div>
                  <!-- Top Row: Icono + Número Gigante -->
                  <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
                    <div class="w-12 h-12 rounded-2xl bg-white border border-zinc-200 flex items-center justify-center group-hover:bg-[#26CCCA]/10 transition-colors" set:html={pillar.icon}>
                    </div>
                    <span class="font-bebas text-4xl text-zinc-300 group-hover:text-[#26CCCA] transition-colors leading-none">
                      {pillar.number}
                    </span>
                  </div>

                  <!-- Tag Editorial Limpio -->
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
                    {pillar.tag}
                  </span>

                  <!-- Título -->
                  <h3 class="font-outfit text-2xl font-bold text-[#030303] mb-4 leading-tight">
                    {pillar.title}
                  </h3>

                  <!-- Descripción -->
                  <p class="font-poppins text-sm text-[#52525B] leading-relaxed mb-6">
                    {pillar.description}
                  </p>
                </div>

                <!-- Puntos Clave con checkmark limpio -->
                <div class="pt-4 border-t border-black/5 space-y-2 font-poppins text-xs text-zinc-600">
                  {pillar.points.map((point) => (
                    <div class="flex items-center gap-2">
                      <span class="text-[#26CCCA] font-bold text-xs shrink-0">✓</span>
                      <span>{point}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- C. QUÉ CAMBIA CON SOLUCIONES DIGITALES SERVICIOS PROFESIONALES -->
        <div class="p-8 sm:p-12 lg:p-14 rounded-3xl bg-[#030303] text-white border border-white/10 relative overflow-hidden shadow-2xl">
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-[#26CCCA]/10 rounded-full blur-3xl pointer-events-none"></div>

          <div class="max-w-2xl mb-12 relative z-10">
            <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-2">
              RESULTADOS COMPROBADOS
            </span>
            <h3 class="font-bebas text-3xl sm:text-5xl text-white tracking-tight uppercase leading-none">
              Qué Cambia con Soluciones Digitales para <span class="text-[#26CCCA]">Servicios Profesionales</span>
            </h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
            {professionalTransformations.map((trans) => (
              <div class="flex flex-col justify-between border-t border-white/15 pt-6 group">
                <div>
                  <div class="flex items-baseline justify-between mb-3">
                    <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA]">
                      {trans.tag}
                    </span>
                    <span class="font-bebas text-3xl sm:text-4xl text-white group-hover:text-[#26CCCA] transition-colors leading-none">
                      {trans.metric}
                    </span>
                  </div>
                  <h4 class="font-outfit text-xl font-bold text-white mb-3 leading-snug">
                    {trans.title}
                  </h4>
                  <p class="font-poppins text-xs sm:text-sm text-zinc-300 leading-relaxed">
                    {trans.desc}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-white/5">
                  <span class="font-outfit text-[11px] font-semibold text-zinc-400 uppercase tracking-wider">
                    Impacto: {trans.metricLabel}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- 3. SUBSECTORES: SOLUCIONES ESPECÍFICAS POR TIPO DE EMPRESA (3D Circular Split Roll Interactivo) -->
    <CircularSplitRoll 
      items={subsectors} 
      kicker="SUBSECTORES · SOLUCIONES ESPECÍFICAS POR TIPO DE EMPRESA"
      subtitle="Ecosistemas adaptados a los modelos de facturación, entrega de proyectos y relación con clientes de firmas especializadas:"
      footerNote="Ecosistemas digitales sincronizados para firmas profesionales, consultoras y estudios"
      badgeText="6 Especialidades Adaptadas"
    />

    <!-- 4. CARTELERÍA DIGITAL PROFESIONAL (Negro Obsidiana #030303) -->
    <section id="digital-signage" class="py-20 sm:py-28 bg-[#030303] text-white border-y border-white/10 relative overflow-hidden">
      <!-- Glow ambiental suave -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#26CCCA]/10 rounded-full blur-[180px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-10 w-80 h-80 bg-[#26CCCA]/5 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-[1400px] mx-auto px-4 sm:px-8 lg:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          
          <!-- Columna Izquierda: Información de Digital Signage (7 Cols) -->
          <div class="lg:col-span-7 flex flex-col justify-center">
            
            <!-- Tag Editorial Limpio -->
            <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
              CARTELERÍA DIGITAL PROFESIONAL
            </span>

            <h2 class="font-bebas text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight uppercase leading-[0.95] mb-4">
              AUTORIDAD Y EXPERTISE EN CADA <br class="hidden sm:block" />
              <span class="text-[#26CCCA]">ESPACIO DE TU FIRMA</span>
            </h2>

            <p class="font-poppins text-sm sm:text-base lg:text-lg text-zinc-300 leading-relaxed mb-6 max-w-xl">
              Implementamos pantallas inteligentes en salas de reuniones y oficinas que proyectan una imagen de vanguardia. Exhibe portafolios de proyectos y casos de éxito para construir confianza antes de cada interacción.
            </p>

            <!-- 3 Beneficios Clave con ✓ -->
            <div class="space-y-3.5 mb-8 font-poppins text-xs sm:text-sm text-zinc-300">
              <div class="flex items-start gap-3">
                <span class="text-[#26CCCA] font-bold text-base shrink-0">✓</span>
                <span><strong>Recepción y Salas de Directorio de Alto Impacto:</strong> proyecta credenciales corporativas, casos de estudio y reconocimientos mientras tus clientes esperan su reunión.</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-[#26CCCA] font-bold text-base shrink-0">✓</span>
                <span><strong>Portafolios de Proyectos y Métricas en Tiempo Real:</strong> demuestra solidez técnica y antecedentes de éxito con presentaciones dinámicas interactuables.</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-[#26CCCA] font-bold text-base shrink-0">✓</span>
                <span><strong>Bienvenida Personalizada para Visitas Clave:</strong> actualiza de manera remota los mensajes de recepción para mandantes estratégicos desde una consola en la nube.</span>
              </div>
            </div>

            <!-- CTA Button -->
            <div>
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-4 px-8 inline-flex items-center gap-2.5 border border-white/20 shadow-lg text-center cursor-pointer"
              >
                <span>Transforma tu comunicación visual</span>
                <svg class="w-4 h-4 text-[#26CCCA]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>

          </div>

          <!-- Columna Derecha: Mockup Visual de Pantalla Digital en Sala de Directorio (5 Cols) -->
          <div class="lg:col-span-5 flex items-center justify-center">
            <div class="relative w-full aspect-[4/3] rounded-3xl overflow-hidden border border-white/15 bg-white/5 shadow-2xl group">
              <img 
                src="/mockup/industry_servicios_1786829835822.jpg" 
                alt="Pantallas Inteligentes y Cartelería Digital en Sala de Directorio Corporativa" 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 5. BENEFICIOS DE TRABAJAR CON BOOSTED (Blanco Puro #FFFFFF con HowItWorks) -->
    <section id="por-que-boosted" class="py-24 sm:py-32 bg-[#FFFFFF] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Bloque How-It-Works con Línea de Conexión Continua y Estilos Boosted -->
        <HowItWorks 
          title="BENEFICIOS DE TRABAJAR"
          titleAccent="CON BOOSTED"
          subtitle="Elegir el partner correcto hace la diferencia. Diseñamos ecosistemas que unifican pipeline comercial, gestión de proyectos y presencia de autoridad para firmas de servicios profesionales:"
          steps={boostedReasons}
          layout="columns"
          className="mb-16"
        />

        <!-- Banner de Conversión Inferior: Diseño Integrado con Charlie en Directorio Corporativo -->
        <div class="rounded-3xl bg-[#070708] text-white border border-white/10 relative overflow-hidden shadow-2xl group">
          <!-- Glows ambientales sutiles -->
          <div class="absolute -right-20 -top-20 w-96 h-96 bg-[#26CCCA]/10 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -left-20 -bottom-20 w-96 h-96 bg-[#26CCCA]/5 rounded-full blur-3xl pointer-events-none"></div>

          <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch relative z-10">
            <!-- Columna Izquierda: Charlie Managing Director en Reunión Corporativa -->
            <div class="lg:col-span-5 relative w-full min-h-[340px] sm:min-h-[400px] lg:min-h-[460px] overflow-hidden">
              <!-- Glow ambiental sutil que aporta luz al entorno de Charlie -->
              <div class="absolute -top-12 -left-12 w-80 h-80 bg-[#26CCCA]/15 rounded-full blur-3xl pointer-events-none"></div>

              <img 
                src="/mockup/charlie_servicios_prof.jpg" 
                alt="Charlie™ - Asistente y Consultor Estratégico en Reunión de Directorio Corporativo" 
                class="w-full h-full object-cover object-center brightness-[1.05] contrast-[1.02] transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />

              <!-- Desvanecido suave únicamente en el borde derecho final -->
              <div class="absolute inset-y-0 right-0 w-24 sm:w-36 bg-gradient-to-r from-transparent to-[#070708] pointer-events-none hidden lg:block"></div>
              <div class="absolute inset-x-0 bottom-0 h-16 sm:h-24 bg-gradient-to-t from-[#070708] to-transparent pointer-events-none lg:hidden"></div>
            </div>

            <!-- Columna Derecha: Contenido Breve y CTA de Conversión -->
            <div class="lg:col-span-7 p-8 sm:p-12 lg:p-14 flex flex-col justify-center">
              <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
                COMIENZA AHORA
              </span>

              <h3 class="font-outfit text-2xl sm:text-3xl lg:text-4xl font-bold text-white leading-tight mb-4 tracking-tight">
                Lidera la Evolución Tecnológica de tu Firma Profesional
              </h3>

              <p class="font-poppins text-sm sm:text-base text-zinc-300 leading-relaxed mb-8 max-w-xl">
                Elimina las fugas comerciales y la falta de trazabilidad en tus proyectos. En Boosted estamos listos para estructurar el ecosistema digital que posicionará a tu firma en el segmento más rentable.
              </p>

              <div>
                <a 
                  href={calendarUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-white text-[#030303] font-outfit font-bold text-xs uppercase tracking-wider hover:bg-[#26CCCA] hover:text-[#030303] transition-all duration-300 shadow-xl hover:shadow-[0_0_30px_rgba(38,204,202,0.4)] group cursor-pointer"
                >
                  <span>AGENDAR CONSULTORÍA GRATUITA</span>
                  <svg class="w-4 h-4 text-[#030303] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 6. CONTACTO REUTILIZADO (Componente Oficial Contact.astro) -->
    <Contact />

  </main>

  <Footer />
</Layout>
