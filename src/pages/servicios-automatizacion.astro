---
// src/pages/servicios-automatizacion.astro - Página Oficial "Automatización de Procesos" de Boosted (boosted.cl)
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

// 6 Formas clave de integrar la automatización de procesos en tu negocio
const integrationMethods = [
  {
    number: "01",
    badge: "Sin Digitación",
    title: "Captura Automática",
    description: "Centralizamos datos de formularios y correos directo a tus sistemas. Sin digitación manual, tu base siempre ordenada.",
    tech: "Forms ➔ Webhooks ➔ CRM / BD",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>`
  },
  {
    number: "02",
    badge: "Flujo Continuo",
    title: "Tareas Operativas",
    description: "Recordatorios, asignaciones y aprobaciones que mantienen tu operación fluyendo sola.",
    tech: "Triggers & Reglas Automáticas",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>`
  },
  {
    number: "03",
    badge: "Respuesta Inmediata",
    title: "Flujos de Soporte",
    description: "Automatizamos respuestas y derivaciones de tickets para mejorar dramáticamente tus tiempos de atención.",
    tech: "Enrutamiento Inteligente & SLAs",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`
  },
  {
    number: "04",
    badge: "Avisos Cruzados",
    title: "Comunicación Interna",
    description: "Avisos automáticos entre áreas. Garantizamos que cada responsable tenga la información a tiempo.",
    tech: "Slack, WhatsApp & Teams API",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`
  },
  {
    number: "05",
    badge: "Métricas 24/7",
    title: "Reportes en Vivo",
    description: "Consolidamos tu información en tableros automáticos. Indicadores clave sin hacer informes a mano.",
    tech: "Live BI, Looker & Dashboards",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`
  },
  {
    number: "06",
    badge: "Ecosistema Unificado",
    title: "Integración de Software",
    description: "Conectamos tus aplicaciones para que hablen entre sí. Tu ecosistema digital funcionando como un todo.",
    tech: "REST APIs & Webhooks Nativos",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" /></svg>`
  }
];

// Beneficios de trabajar con Boosted
const benefits = [
  {
    number: "01",
    title: "Menos tareas manuales",
    highlight: "Más foco en decisiones y proyectos clave.",
    detail: "Libera a tu equipo del trabajo repetitivo para que inviertan su tiempo en generar ventas, atender clientes y planificar la estrategia."
  },
  {
    number: "02",
    title: "Procesos ordenados y escalables",
    highlight: "Fáciles de escalar con el crecimiento.",
    detail: "Tu negocio puede duplicar o triplicar su volumen de clientes sin necesidad de duplicar tu headcount ni colapsar tu logística."
  },
  {
    number: "03",
    title: "Cero errores humanos",
    highlight: "Asegurando una experiencia consistente.",
    detail: "Estandarización rigurosa de datos. Cada contacto recibe seguimiento a tiempo y ningún lead o ticket se queda sin respuesta."
  },
  {
    number: "04",
    title: "Base lista para Inteligencia Artificial",
    highlight: "Base lista para seguir integrando IA y nuevas tecnologías.",
    detail: "Estructuramos tu arquitectura digital para que puedas incorporar Agentes de IA autónomos (como Charlie™) sin fricciones ni retrasos."
  }
];

const calendarUrl = "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ0eLzWvh-yrlAvDqP4vCBpex5c2wtzqpp89n_C4VVp6Obx184OHVTcQxAJBAtq4CtJtcYmyMuuA";
---

<Layout 
  title="Automatización de Procesos — Ecosistemas Digitales Imparables | Boosted.cl"
  description="Elimina tareas repetitivas, reduce errores y libera tiempo para lo que realmente importa: crecer y vender. Diseñamos ecosistemas digitales donde tus herramientas trabajan coordinadas, sin depender del control manual constante."
>
  <Navbar />

  <main class="flex-grow">

    <!-- 1. HERO SECTION (Negro Obsidiana #050505 con Acentos Cian & Pipeline Visual) -->
    <section class="min-h-[calc(100vh-76px)] bg-[#050505] text-white relative flex flex-col justify-center px-6 sm:px-12 lg:px-20 py-20 lg:py-28 overflow-hidden select-none">
      
      <!-- Fondo Cinematográfico y Texturas de Profundidad -->
      <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden">
        <img 
          src="/mockup/hero_nosotros_texture.jpg" 
          alt="Boosted Automation Texture" 
          class="w-full h-full object-cover object-center opacity-25 brightness-90 contrast-125 scale-105"
        />
        <!-- Viñetas de gradiente -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-90"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-transparent to-[#050505] opacity-80"></div>
        <div class="absolute top-1/3 left-1/4 w-[500px] h-[350px] bg-[#26CCCA]/10 rounded-full blur-[160px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[300px] bg-[#0E8A88]/15 rounded-full blur-[180px]"></div>
      </div>

      <!-- Contenido Principal del Hero (Ultra Limpio, Minimalista y Respirable) -->
      <div class="w-full max-w-[1360px] mx-auto my-auto py-12 sm:py-16 relative z-10">
        
        <!-- Titular Limpio y Poderoso -->
        <div class="max-w-5xl mb-8">
          <h1 class="font-bebas text-5xl sm:text-7xl md:text-8xl lg:text-[6.8rem] text-white tracking-tight uppercase leading-[0.93] block">
            AUTOMATIZACIÓN DE PROCESOS
          </h1>
          <div class="font-bebas text-4xl sm:text-6xl md:text-7xl lg:text-[5.8rem] tracking-tight uppercase leading-[0.93] block mt-1 sm:mt-2">
            <span class="bg-gradient-to-r from-[#26CCCA] via-[#3DE8E5] to-[#0E8A88] bg-clip-text text-transparent">
              ECOSISTEMA DIGITAL IMPARABLE
            </span>
          </div>
        </div>

        <!-- Párrafo Resumido y Directo -->
        <p class="font-poppins text-lg sm:text-xl lg:text-2xl text-zinc-300 font-normal leading-relaxed max-w-2xl mb-10">
          Elimina tareas repetitivas, reduce errores y libera tiempo para lo que realmente importa: <strong class="text-white font-medium">crecer y vender</strong>.
        </p>

        <!-- Botones de Acción Elegantes -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <!-- CTA 1: Hablar con un Asesor -->
          <a 
            href="#contacto" 
            class="btn-primary text-xs uppercase tracking-wider py-4 px-8 inline-flex items-center justify-center gap-2.5 border border-white/20 shadow-lg text-center"
          >
            <span>Hablar con un Asesor</span>
            <svg class="w-4 h-4 text-[#26CCCA] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          <!-- CTA 2: Agendar Asesoría Gratuita -->
          <a 
            href={calendarUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full border border-white/20 bg-white/[0.05] hover:bg-white/[0.12] hover:border-[#26CCCA] text-white font-outfit text-xs font-bold uppercase tracking-wider transition-all duration-200 inline-flex items-center justify-center gap-2 text-center"
          >
            <span>Agendar Asesoría Gratuita</span>
            <svg class="w-4 h-4 text-[#26CCCA] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </a>
        </div>

      </div>

    </section>

    <!-- 2. FORMAS CLAVE DE INTEGRAR LA AUTOMATIZACIÓN (Blanco Puro #FFFFFF) -->
    <section id="formas-integracion" class="py-24 sm:py-32 bg-[#FFFFFF] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            FORMAS CLAVE DE INTEGRAR LA AUTOMATIZACIÓN EN TU NEGOCIO
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            EFICIENCIA OPERATIVA <span class="border-b-4 border-[#26CCCA] inline-block">SIN PERDER EL CONTROL</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            Descubre formas concretas de integrar la automatización en tu ecosistema digital para ganar eficiencia operativa sin perder el control de tu negocio.
          </p>
        </div>

        <!-- Grilla de las 6 Formas Clave -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-16">
          {integrationMethods.map((method) => (
            <div class="luxury-card group flex flex-col justify-between p-8 rounded-3xl bg-white border border-zinc-200 hover:border-[#26CCCA] hover:-translate-y-1 transition-all duration-300 relative min-h-[320px]">
              <div>
                <!-- Top Row: Icono + Número Grande -->
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
                  <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center group-hover:bg-[#26CCCA]/10 transition-colors" set:html={method.icon}>
                  </div>
                  <span class="font-bebas text-4xl text-zinc-300 group-hover:text-[#26CCCA] transition-colors leading-none">
                    {method.number}
                  </span>
                </div>

                <!-- Título del Método -->
                <h3 class="font-outfit text-2xl font-bold text-[#030303] mb-3 leading-tight">
                  {method.title}
                </h3>

                <!-- Descripción Oficial del Bloque -->
                <p class="font-poppins text-sm text-[#52525B] leading-relaxed mb-6">
                  {method.description}
                </p>
              </div>

              <!-- Footer de la Tarjeta: Badge de Precisión & Stack -->
              <div class="pt-4 border-t border-black/5 flex items-center justify-between text-xs font-outfit">
                <span class="inline-flex items-center gap-1.5 uppercase font-bold text-[#0E8A88]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#26CCCA]"></span>
                  {method.badge}
                </span>
                <span class="text-zinc-400 font-medium">{method.tech}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Quote / Statement de Priorización Estratégica de Boosted -->
        <div class="rounded-3xl bg-[#050505] text-white p-8 sm:p-12 border border-white/10 relative overflow-hidden shadow-xl">
          <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-[#26CCCA]/10 rounded-full blur-3xl pointer-events-none"></div>
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            <div class="lg:col-span-8">
              <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
                ENFOQUE ESTRATÉGICO BOOSTED
              </span>
              <p class="font-outfit text-xl sm:text-2xl lg:text-3xl font-bold text-white leading-snug">
                "En Boosted priorizamos primero los procesos que más impacto tienen en tu tiempo y en tus resultados comerciales, para que la automatización de procesos se traduzca en <span class="text-[#26CCCA]">beneficios visibles en pocas semanas</span>."
              </p>
            </div>
            <div class="lg:col-span-4 flex lg:justify-end">
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-4 px-8 inline-flex items-center gap-2 border border-white/20 whitespace-nowrap"
              >
                <span>Diagnosticar mis procesos</span>
                <svg class="w-4 h-4 text-[#26CCCA]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3. BENEFICIOS DE TRABAJAR CON BOOSTED (Blanco Puro con Tarjetas Estructuradas) -->
    <section id="beneficios" class="py-24 sm:py-32 bg-[#F8F9FA] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            BENEFICIOS DE TRABAJAR CON BOOSTED
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            LO QUE CAMBIA CUANDO <span class="border-b-4 border-[#26CCCA] inline-block">AUTOMATIZAS CON NOSOTROS</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            Lo que cambia cuando automatizas tus tareas y procesos con nosotros:
          </p>
        </div>

        <!-- Grilla de Beneficios en 4 Tarjetas de Lujo -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          {benefits.map((b) => (
            <div class="luxury-card group flex flex-col justify-between p-8 rounded-3xl bg-white border border-zinc-200 hover:border-[#26CCCA] hover:-translate-y-1 transition-all duration-300 relative min-h-[300px]">
              <div>
                <!-- Top: Número + Checkmark -->
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
                  <span class="font-bebas text-4xl text-zinc-300 group-hover:text-[#26CCCA] transition-colors leading-none">
                    {b.number}
                  </span>
                  <div class="w-8 h-8 rounded-full bg-[#26CCCA]/15 text-[#0E8A88] flex items-center justify-center font-bold text-sm">
                    ✓
                  </div>
                </div>

                <!-- Título del Beneficio -->
                <h3 class="font-outfit text-xl sm:text-2xl font-bold text-[#030303] mb-3 leading-snug">
                  {b.title}
                </h3>

                <!-- Highlight Oficial -->
                <p class="font-poppins text-sm font-semibold text-[#0E8A88] mb-3">
                  {b.highlight}
                </p>

                <!-- Detalle Contextual -->
                <p class="font-poppins text-xs text-[#52525B] leading-relaxed">
                  {b.detail}
                </p>
              </div>

              <!-- Footer Indicator -->
              <div class="pt-4 border-t border-black/5 flex items-center gap-2 text-xs font-outfit uppercase font-semibold text-[#0E8A88]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#26CCCA]"></span>
                <span>Impacto Operativo Comprobado</span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. ¿POR QUÉ ELEGIR BOOSTED? (Negro Obsidiana #030303 - Arquitectura Dual Compacta y Pulida) -->
    <section id="por-que-elegir" class="py-16 sm:py-20 lg:py-24 bg-[#030303] text-white border-y border-white/10 relative overflow-hidden">
      <!-- Glows ambientales sutiles -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#26CCCA]/10 rounded-full blur-[180px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-10 w-72 h-72 bg-[#26CCCA]/5 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Header de Sección Compacto y Centrado -->
        <div class="max-w-2xl mx-auto text-center mb-10 sm:mb-12">
          <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-2">
            VENTAJA ESTRATÉGICA
          </span>
          <h2 class="font-bebas text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight uppercase leading-[0.95] mb-3">
            ¿POR QUÉ ELEGIR <span class="text-[#26CCCA]">BOOSTED</span>?
          </h2>
          <p class="font-poppins text-xs sm:text-sm text-zinc-400 leading-relaxed max-w-lg mx-auto">
            No implementamos software aislado ni recetas genéricas. Construimos un ecosistema donde tu visión de negocio lidera y la tecnología ejecuta sin fricción.
          </p>
        </div>

        <!-- Grilla de los 2 Grandes Pilares (Formato Compacto y Refinado) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 mb-10 sm:mb-12">
          
          <!-- Pilar 01: Estrategia + Automatización Integrada -->
          <div class="group relative rounded-2xl sm:rounded-3xl bg-[#080808] border border-white/10 hover:border-[#26CCCA]/50 p-6 sm:p-7 lg:p-8 transition-all duration-300 flex flex-col justify-between overflow-hidden shadow-xl hover:-translate-y-1">
            <!-- Línea luminosa superior en hover -->
            <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-[#26CCCA]/30 to-transparent group-hover:via-[#26CCCA] transition-all duration-500"></div>
            
            <div>
              <!-- Top Row: Icono + Número Gigante Fantasma + Badge -->
              <div class="flex items-center justify-between mb-5 pb-4 border-b border-white/10">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-white/[0.05] border border-white/10 text-[#26CCCA] flex items-center justify-center group-hover:bg-[#26CCCA] group-hover:text-[#030303] transition-all duration-300 shadow-sm shrink-0">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <span class="px-2.5 py-0.5 rounded-full text-[11px] font-outfit uppercase font-bold tracking-wider text-[#26CCCA] bg-[#26CCCA]/10 border border-[#26CCCA]/20">
                    Sinergia Estratégica
                  </span>
                </div>

                <span class="font-bebas text-4xl sm:text-5xl text-white/10 group-hover:text-[#26CCCA]/40 transition-colors leading-none">
                  01
                </span>
              </div>

              <!-- Título y Descripción Principal -->
              <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white mb-2 leading-tight">
                Estrategia + Automatización Integrada
              </h3>

              <p class="font-poppins text-xs sm:text-sm text-zinc-300 leading-relaxed mb-5">
                Combinamos desarrollo estratégico y automatización para que tu empresa gane tiempo sin sumar carga operativa.
              </p>
            </div>

            <!-- Entregables / Claves de Valor -->
            <div class="pt-4 border-t border-white/10 space-y-2 font-poppins text-xs text-zinc-400">
              <div class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#26CCCA] shrink-0"></span>
                <span>Diagnóstico profundo de cuellos de botella antes de configurar herramientas.</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#26CCCA] shrink-0"></span>
                <span>Flujos integrados a la medida de tu ciclo comercial y soporte.</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#26CCCA] shrink-0"></span>
                <span>Horas de trabajo manual recuperadas desde el primer mes.</span>
              </div>
            </div>
          </div>

          <!-- Pilar 02: Acompañamiento Integral de Punta a Punta -->
          <div class="group relative rounded-2xl sm:rounded-3xl bg-[#080808] border border-white/10 hover:border-[#26CCCA]/50 p-6 sm:p-7 lg:p-8 transition-all duration-300 flex flex-col justify-between overflow-hidden shadow-xl hover:-translate-y-1">
            <!-- Línea luminosa superior en hover -->
