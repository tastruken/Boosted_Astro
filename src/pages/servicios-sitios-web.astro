    href: "https://boosted.cl/portfolio-kitty-zone.html",
    tag: "Boutique E-commerce",
    featuredBadge: "Mobile First & Privacidad"
  }
];

// Metodología en 3 Fases Rigurosas (Versión Ejecutiva & Concisa)
const methodologyPhases = [
  {
    phase: "01",
    badge: "Fase 1: Estrategia & UX",
    title: "Arquitectura de la Información y UX",
    description: "Diseñamos la ruta del cliente antes de programar. Eliminamos fricciones y estructuramos flujos intuitivos para guiar cada visita directamente a la conversión (agendar, cotizar o comprar).",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>`,
    keyPoints: [
      "Mapeo de ruta (Customer Journey)",
      "Wireframes enfocados en conversión",
      "Estructura sin puntos de fricción"
    ]
  },
  {
    phase: "02",
    badge: "Fase 2: Código & Conexión",
    title: "Desarrollo e Integración al Ecosistema",
    description: "Construimos con código limpio y conectamos tu web a tu negocio: CRM, ERP y automatizaciones. Tu sitio opera rápido, seguro y sincronizado desde el primer día.",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    keyPoints: [
      "Conexión nativa con CRM, ERP y bases de datos",
      "Píxeles y telemetría de ventas preconfigurados",
      "Carga ultrarrápida (< 1s) con código optimizado"
    ]
  },
  {
    phase: "03",
    badge: "Fase 3: Medición & SEO",
    title: "Optimización para Conversión (CRO)",
    description: "Sitios autoadministrables preparados para crecer. Implementamos SEO técnico para indexar en Google y telemetría analítica para medir y optimizar conversiones continuamente.",
    icon: `<svg class="w-6 h-6 text-[#030303] group-hover:text-[#26CCCA] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>`,
    keyPoints: [
      "Autoadministración ágil y capacitación",
      "Arquitectura y SEO técnico para Google",
      "Telemetría continua para optimización CRO"
    ]
  }
];

// Preguntas Frecuentes (FAQ Oficiales)
const faqs = [
  {
    q: "¿Realizan desarrollo a código o mantención post-lanzamiento?",
    a: "Nos adaptamos a tu necesidad. Si el proyecto lo requiere, desarrollamos en código a medida. Respecto a la continuidad, ofrecemos flexibilidad total: podemos hacernos cargo de la mantención técnica y actualizaciones de seguridad, o bien, entregar todo el código y la documentación necesaria para que tu equipo interno tome el control total del proyecto."
  },
  {
    q: "¿Los sitios web son autoadministrables?",
    a: "Sí. Desarrollamos sobre plataformas robustas que te permiten editar textos, subir imágenes y crear nuevas entradas de blog sin depender de un programador para cada cambio menor."
  },
  {
    q: "¿Incluyen optimización para móviles?",
    a: "Absolutamente. Aplicamos el enfoque “Mobile First”. Dado que la mayoría del tráfico actual proviene de celulares, aseguramos que la experiencia de usuario sea perfecta en cualquier dispositivo."
  },
  {
    q: "¿Pueden conectar el sitio a mi CRM actual?",
    a: "Claro que sí. Como expertos en automatización, integramos tu web con herramientas como HubSpot, Salesforce, ActiveCampaign, o Google Sheets, para que ningún dato se pierda."
  },
  {
    q: "¿Por qué invertir en Sitios Web y Experiencia Digital?",
    a: "En el mercado actual, la diferencia entre vender y perder un cliente está en la usabilidad. Nuestros servicios de Sitios Web y Experiencia Digital están garantizados para reducir la tasa de rebote. No dejes tu presencia online al azar; agenda una asesoría y llevemos tus Sitios Web y Experiencia Digital al siguiente nivel de conversión."
  }
];

const calendarUrl = "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ0eLzWvh-yrlAvDqP4vCBpex5c2wtzqpp89n_C4VVp6Obx184OHVTcQxAJBAtq4CtJtcYmyMuuA";
---

<Layout 
  title="Sitios Web y Experiencia Digital: Estrategias de Éxito 2025 | Boosted.cl"
  description="En Boosted, un sitio web no es una simple tarjeta de presentación digital; es el corazón operativo de tu ecosistema. Unimos diseño UX/UI y tecnología para acelerar tu crecimiento y conversión."
>
  <Navbar />

  <main class="flex-grow">

    <!-- 1. HERO SECTION (Negro Obsidiana #050505 con Acentos Cian & Estilo Editorial Abierto) -->
    <section class="min-h-[calc(100vh-80px)] bg-[#050505] text-white relative flex items-center px-6 sm:px-12 lg:px-20 py-12 lg:py-16 overflow-hidden select-none">
      
      <!-- Fondo Cinematográfico y Texturas de Profundidad -->
      <div class="absolute inset-0 pointer-events-none select-none z-0 overflow-hidden">
        <img 
          src="/mockup/hero_architecture_noir.webp" 
          alt="Boosted Web & UX Architecture Texture" 
          class="w-full h-full object-cover object-right lg:object-center opacity-30 brightness-90 contrast-125 scale-105"
          loading="eager"
          decoding="async"
        />
        <!-- Viñetas de gradiente que dejan visible la imagen de fondo -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-80"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/50 to-transparent opacity-85"></div>
        <div class="absolute top-1/3 left-1/4 w-[500px] h-[350px] bg-[#26CCCA]/15 rounded-full blur-[160px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[300px] bg-[#0E8A88]/20 rounded-full blur-[180px]"></div>
      </div>

      <!-- Contenido Principal en Grilla de 2 Columnas -->
      <div class="w-full max-w-[1400px] mx-auto relative z-10 py-6 sm:py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna Izquierda: Titulares, Narrativa y CTAs (7 Columnas) -->
          <div class="lg:col-span-7 flex flex-col justify-center">



            <!-- Titular Proporcionado e Impactante -->
            <h1 class="font-bebas text-4xl sm:text-6xl lg:text-[4.6rem] text-white tracking-tight uppercase leading-[0.95] mb-4">
              SITIOS WEB Y EXPERIENCIA DIGITAL<br />
              <span class="bg-gradient-to-r from-[#26CCCA] via-[#3DE8E5] to-[#0E8A88] bg-clip-text text-transparent">
                ESTRATEGIAS DE ÉXITO 2025
              </span>
            </h1>

            <!-- Párrafo Claro y Respirable -->
            <p class="font-poppins text-sm sm:text-base lg:text-lg text-zinc-300 font-normal leading-relaxed max-w-xl mb-6">
              En Boosted, un sitio web no es una simple tarjeta de presentación digital; es el <strong class="text-white font-medium">corazón operativo de tu ecosistema</strong>. Diseñamos herramientas comerciales de alto impacto UX/UI creadas para captar leads calificados, agendar reuniones y cerrar ventas.
            </p>

            <!-- Botones de Acción Inmediatos -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
              <!-- CTA 1: Hablemos sobre tu Sitio Web -->
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-3.5 px-7 inline-flex items-center justify-center gap-2.5 border border-white/20 shadow-lg text-center"
              >
                <span>Hablemos sobre tu Sitio Web</span>
                <svg class="w-4 h-4 text-[#26CCCA] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </a>

              <!-- CTA 2: Ver Proyectos -->
              <a 
                href="#portafolio" 
                class="px-7 py-3.5 rounded-full border border-white/20 bg-white/[0.05] hover:bg-white/[0.12] hover:border-[#26CCCA] text-white font-outfit text-xs font-bold uppercase tracking-wider transition-all duration-200 inline-flex items-center justify-center gap-2 text-center"
              >
                <span>Ver Proyectos</span>
                <span class="text-[#26CCCA]">↓</span>
              </a>
            </div>

          </div>

          <!-- Columna Derecha: Pilares en Estilo Editorial Abierto (Sin cajas ni recuadros) -->
          <div class="lg:col-span-5 flex flex-col justify-center gap-8 lg:gap-10 lg:pl-6">
            
            <!-- Pilar 1: Webs que Convierten -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    El Enfoque
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Webs que Convierten
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-white group-hover:text-[#26CCCA] transition-colors leading-none tracking-tight shrink-0">
                  24/7
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Digitalizamos procesos comerciales transformando visitas en prospectos calificados con captura de datos inteligente.
              </p>
            </div>

            <!-- Divisor sutil entre métricas -->
            <div class="h-px w-full bg-gradient-to-r from-white/10 via-white/5 to-transparent"></div>

            <!-- Pilar 2: Velocidad & Sincronía -->
            <div class="relative pl-6 border-l-2 border-[#26CCCA]/40 hover:border-[#26CCCA] transition-colors duration-300 group">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <div>
                  <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-1">
                    Rendimiento & Integración
                  </span>
                  <h3 class="font-outfit text-xl sm:text-2xl font-bold text-white tracking-tight">
                    Carga Ultrarrápida
                  </h3>
                </div>
                <span class="font-bebas text-6xl sm:text-7xl text-[#26CCCA] leading-none tracking-tight shrink-0">
                  &lt; 1s
                </span>
              </div>
              <p class="font-poppins text-xs sm:text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
                Experiencia de usuario móvil sin esperas, integrada directamente con tu CRM y automatizaciones de venta.
              </p>
            </div>

          </div>

        </div>
      </div>

    </section>

    <!-- 2. CASOS DE ÉXITO: EXPERIENCIAS DIGITALES QUE IMPULSAN NEGOCIOS (Blanco Puro #FFFFFF) -->
    <section id="portafolio" class="py-24 sm:py-32 bg-[#FFFFFF] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            CASOS DE ÉXITO
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            EXPERIENCIAS DIGITALES <span class="border-b-4 border-[#26CCCA] inline-block">QUE IMPULSAN NEGOCIOS</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            Descubre cómo hemos transformado la presencia digital de empresas B2B, convirtiendo sitios estáticos en activos operativos rentables.
          </p>
        </div>

        <!-- Grilla de los 10 Casos de Éxito en 3 Columnas con NotchedProjectCard -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10 mb-16">
          {portfolioProjects.map((project) => (
            <NotchedProjectCard
              href={project.href}
              title={project.title}
              description={project.description}
              image="/mockup/hero_studio_visual_opt.webp"
              imageAlt={`Mockup ${project.title}`}
              category={project.category}
              number={project.number}
              tags={[project.tag, project.featuredBadge]}
              surface="#FFFFFF"
            />
          ))}
        </div>

        <!-- Banner de Conversión: ¿Quieres resultados similares? -->
        <div class="rounded-3xl bg-[#050505] text-white p-8 sm:p-12 border border-white/10 relative overflow-hidden shadow-xl">
          <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-[#26CCCA]/10 rounded-full blur-3xl pointer-events-none"></div>
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            <div class="lg:col-span-8">
              <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-3">
                RESULTADOS COMPROBADOS
              </span>
              <p class="font-outfit text-xl sm:text-2xl lg:text-3xl font-bold text-white leading-snug">
                "¿Quieres resultados similares para tu negocio? Diseñemos una web que no solo se vea increíble, sino que <span class="text-[#26CCCA]">venda y opere 24/7</span>."
              </p>
            </div>
            <div class="lg:col-span-4 flex lg:justify-end">
              <a 
                href="#contacto" 
                class="btn-primary text-xs uppercase tracking-wider py-4 px-8 inline-flex items-center gap-2 border border-white/20 whitespace-nowrap"
              >
                <span>Conversemos sobre tu Proyecto</span>
                <svg class="w-4 h-4 text-[#26CCCA]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3. NUESTRA METODOLOGÍA: WEBS PREPARADAS PARA EL FUTURO (Gris Muy Claro #F8F9FA) -->
    <section id="metodologia" class="py-24 sm:py-32 bg-[#F8F9FA] text-[#030303] border-t border-black/[0.06] relative">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
        
        <!-- Header de Sección -->
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-outfit text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0E8A88] block mb-3">
            NUESTRA METODOLOGÍA
          </span>
          <h2 class="font-bebas text-5xl sm:text-6xl lg:text-7xl text-[#030303] tracking-tight uppercase leading-[0.95] mb-5">
            WEBS PREPARADAS <span class="border-b-4 border-[#26CCCA] inline-block">PARA EL FUTURO</span>
          </h2>
          <p class="font-poppins text-base sm:text-lg text-[#52525B] leading-relaxed">
            A diferencia de las agencias tradicionales que solo entregan “diseños bonitos”, en Boosted construimos activos digitales. Nuestro proceso sigue tres fases rigurosas para asegurar el retorno de inversión:
          </p>
        </div>

        <!-- Grilla de las 3 Fases de Metodología -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          {methodologyPhases.map((phase) => (
            <div class="luxury-card group flex flex-col justify-between p-8 sm:p-10 rounded-3xl bg-white border border-zinc-200 hover:border-[#26CCCA] hover:-translate-y-1 transition-all duration-300 relative min-h-[380px] shadow-sm hover:shadow-xl">
              <div>
                <!-- Top Row: Icono + Número Gigante -->
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
                  <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center group-hover:bg-[#26CCCA]/10 transition-colors" set:html={phase.icon}>
                  </div>
                  <span class="font-bebas text-4xl text-zinc-300 group-hover:text-[#26CCCA] transition-colors leading-none">
                    {phase.phase}
                  </span>
                </div>

                <!-- Badge de Fase -->
                <span class="inline-flex items-center gap-1.5 uppercase font-bold text-xs text-[#0E8A88] mb-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#26CCCA]"></span>
                  {phase.badge}
                </span>

                <!-- Título de la Fase -->
                <h3 class="font-outfit text-2xl font-bold text-[#030303] mb-4 leading-tight">
                  {phase.title}
                </h3>

                <!-- Descripción Completa Oficial -->
                <p class="font-poppins text-sm text-[#52525B] leading-relaxed mb-6">
                  {phase.description}
                </p>
              </div>

              <!-- Puntos Clave de la Fase -->
              <div class="pt-4 border-t border-black/5 space-y-2 font-poppins text-xs text-zinc-600">
                {phase.keyPoints.map((point) => (
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#26CCCA] shrink-0"></span>
                    <span>{point}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. ¿POR QUÉ ELEGIR BOOSTED? (Negro Obsidiana #030303) -->
    <section id="por-que-elegir-boosted" class="py-16 sm:py-20 lg:py-24 bg-[#030303] text-white border-y border-white/10 relative overflow-hidden">
      <!-- Glows ambientales sutiles -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#26CCCA]/10 rounded-full blur-[180px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-10 w-72 h-72 bg-[#26CCCA]/5 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Header de Sección -->
        <div class="max-w-2xl mx-auto text-center mb-12 sm:mb-16">
          <span class="font-outfit text-xs font-bold uppercase tracking-widest text-[#26CCCA] block mb-2">
            MÁS QUE CÓDIGO, ESTRATEGIA COMERCIAL
          </span>
          <h2 class="font-bebas text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight uppercase leading-[0.95] mb-3">
            ¿POR QUÉ ELEGIR <span class="text-[#26CCCA]">BOOSTED</span> PARA TU DESARROLLO WEB?
          </h2>
          <p class="font-poppins text-xs sm:text-sm text-zinc-400 leading-relaxed max-w-lg mx-auto">
