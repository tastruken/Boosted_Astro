<script>
  // Count-up numérico para las métricas del Hero de Nosotros
  function setupNosotrosCounter() {
    const statsSection = document.getElementById('nosotros-stats');
    if (!statsSection) return;

    const counters = statsSection.querySelectorAll('.stat-counter-nosotros');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          counters.forEach(counter => {
            const rawTarget = counter.getAttribute('data-target');
            const staticVal = counter.getAttribute('data-static');
            if (staticVal) {
              counter.textContent = staticVal;
              return;
            }
            if (!rawTarget) return;

            const target = parseInt(rawTarget, 10);
            const prefix = counter.getAttribute('data-prefix') || '';
            const suffix = counter.getAttribute('data-suffix') || '';
            const duration = 1600;
            const startTime = performance.now();

            function updateNumber(currentTime: number) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              // Easing easeOutExpo
              const easeOut = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
              const current = Math.floor(easeOut * target);

              counter.textContent = `${prefix}${current}${suffix}`;

              if (progress < 1) {
                requestAnimationFrame(updateNumber);
              } else {
                counter.textContent = `${prefix}${target}${suffix}`;
              }
            }

            requestAnimationFrame(updateNumber);
          });
          observer.disconnect();
        }
      });
    }, { threshold: 0.2 });

    observer.observe(statsSection);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNosotrosCounter);
  } else {
    setupNosotrosCounter();
  }
</script>
